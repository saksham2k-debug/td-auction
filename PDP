/* name + price rhythm */
.pc h1{margin:8px 0 18px}
.pc-price{margin-bottom:12px;padding-bottom:0;border-bottom:none!important;display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.pc-tax{font-size:12.5px;color:var(--smoke);margin:0 0 22px}
.pc-tax a{color:var(--noir);border-bottom:1px solid var(--hairline-dk);padding-bottom:1px}
