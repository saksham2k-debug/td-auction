<script>
// Variant selection
document.querySelectorAll('.opt-row, .size-grid').forEach(group => {
  group.addEventListener('click', e => {
    const btn = e.target.closest('.opt');
    if (!btn) return;
    group.querySelectorAll('.opt').forEach(o => o.classList.remove('active'));
    btn.classList.add('active');
  });
});

// Thumb selection
document.querySelectorAll('.thumb').forEach(thumb => {
  thumb.addEventListener('click', () => {
    document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
    thumb.classList.add('active');
    const img = thumb.querySelector('img');
    if (img) document.getElementById('mainImg').src = img.src.replace('width=200', 'width=900');
  });
});

// Q&A toggle
document.querySelectorAll('.qa-q').forEach(q => {
  q.addEventListener('click', () => q.parentElement.classList.toggle('open'));
});

// Variant selection — metal + size
document.querySelectorAll('.metal-grid, .size-grid').forEach(group => {
  group.addEventListener('click', e => {
    const btn = e.target.closest('button');
    if (!btn) return;
    group.querySelectorAll('button').forEach(o => o.classList.remove('active'));
    btn.classList.add('active');
  });
});

// Price details collapse
const priceHead = document.querySelector('.price-details-head');
if (priceHead) {
  priceHead.addEventListener('click', () => {
    priceHead.parentElement.classList.toggle('collapsed');
  });
}

// Price tabs (Breakup / Comparison)
document.querySelectorAll('.price-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    const wrap = tab.closest('.price-details');
    const target = tab.dataset.tab;
    wrap.querySelectorAll('.price-tab').forEach(t => t.classList.remove('active'));
    wrap.querySelectorAll('.price-panel').forEach(p => p.classList.remove('active'));
    tab.classList.add('active');
    wrap.querySelector('#panel-' + target).classList.add('active');
  });
});

// Info accordions (Warranty / Care / Package)
document.querySelectorAll('.info-accordion-head').forEach(head => {
  head.addEventListener('click', () => head.parentElement.classList.toggle('open'));
});
</script>

