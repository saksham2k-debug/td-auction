<style>
/* === Brand tokens — pulled from TD's actual :root + Lucira PDP === */
:root{
  --brand-red:#bf1304;        /* TD --accent-color */
  --brand-red-dark:#740c02;   /* TD --accent-color-darken */
  --sale-red:#ec0101;         /* TD --primary-price-color */
  --ink:#222222;              /* TD --text-color / --heading-color */
  --ink-2:#555555;
  --ink-3:#878787;            /* TD --link-color / --secondary-price-color */
  --ink-4:#bfbfbf;
  --line:#ddd;                /* TD --border-color */
  --line-2:#e5e5e5;
  --bg:#ffffff;
  --bg-soft:#fafafa;
  --bg-pale:#fef5f1;          /* Lucira's cream section bg */
  --bg-card:#f9f9f9;          /* Lucira's inactive variant card bg */
  --success:#428445;          /* TD --t4s-success-color */
  --success-bright:#109533;   /* TD badge new color (in-stock dot) */
  --success-pale:#e7f5ef;
  --warn:#e0b252;             /* TD warning */
  --warn-pale:#fef3c7;
  --sale-pale:#eda19a;        /* TD sale badge pink */
  --radius:0;
  --radius-pill:999px;
  --radius-sm:2px;            /* Lucira's rounded-sm on CTA */
  --radius-md:8px;            /* Lucira's rounded-md on size chips */
  --radius-lg:12px;           /* Lucira's rounded-lg on karat cards */
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{
  font-family:'Poppins', -apple-system, system-ui, sans-serif;
  background:var(--bg);
  color:var(--ink);
  font-size:14px;
  line-height:1.6;
  font-weight:400;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block}
a{color:var(--ink);text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
.container{max-width:1280px;margin:0 auto;padding:0 16px}
@media(min-width:768px){.container{padding:0 24px}}

/* === Promo bar === */
.promo{
  background:var(--ink);
  color:#fff;
  padding:8px 12px;
  text-align:center;
  font-size:11px;
  letter-spacing:0.04em;
  font-weight:400;
  overflow:hidden;
  height:32px;
  position:relative;
}
.promo-track{display:flex;animation:slide 30s linear infinite;gap:32px;white-space:nowrap;align-items:center;height:100%}
.promo-track span{color:#fff;font-weight:500}
.promo-track span b{color:#fff;font-weight:600}
.promo-track span::before{content:"•";color:var(--brand-red);margin-right:14px;font-weight:bold}
@keyframes slide{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* === Header === */
.header{
  background:#fff;
  border-bottom:1px solid var(--line);
  position:sticky;
  top:0;
  z-index:100;
}
.header-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  height:60px;
}
.logo{font-weight:600;font-size:18px;letter-spacing:0.04em;color:var(--ink)}
.logo b{color:var(--brand-red);font-weight:700}
.nav{display:none;gap:28px;font-size:13px;letter-spacing:0.02em;font-weight:500}
.nav a{color:var(--ink);transition:color 0.2s}
.nav a:hover{color:var(--brand-red)}
.header-actions{display:flex;gap:6px;align-items:center}
.icon-btn{width:38px;height:38px;display:inline-flex;align-items:center;justify-content:center;font-size:18px;color:var(--ink);transition:color 0.2s}
.icon-btn:hover{color:var(--brand-red)}
.cart-count{font-size:11px;color:var(--ink-3);margin-left:2px}
.hamburger{display:flex;width:38px;height:38px;align-items:center;justify-content:center;font-size:20px}
@media(min-width:980px){
  .header-inner{height:74px}
  .logo{font-size:22px}
  .nav{display:flex}
  .hamburger{display:none}
}

/* === Breadcrumb === */
.crumb{padding:10px 0 4px;font-size:11px;color:var(--ink-3);overflow-x:auto;white-space:nowrap;-webkit-overflow-scrolling:touch}
.crumb a{color:var(--ink-3)}
.crumb a:hover{color:var(--ink)}
.crumb .sep{margin:0 6px;color:var(--ink-4)}
@media(min-width:768px){.crumb{font-size:12px;padding:12px 0 6px}}

/* === PDP layout === */
.pdp{
  display:grid;
  grid-template-columns:1fr;
  gap:24px;
  padding:8px 0 100px;
}
@media(min-width:980px){
  .pdp{
    grid-template-columns:1.15fr 1fr;
    gap:48px;
    padding:8px 0 60px;
  }
}

/* === Gallery === */
.gallery-main{
  aspect-ratio:1;
  background:var(--bg-soft);
  overflow:hidden;
  position:relative;
}
.gallery-main img{width:100%;height:100%;object-fit:cover}
.gallery-badge{
  position:absolute;
  top:12px;
  left:12px;
  background:var(--brand-red);
  color:#fff;
  font-size:10px;
  letter-spacing:0.08em;
  font-weight:600;
  padding:5px 10px;
  text-transform:uppercase;
  border-radius:var(--radius-pill);
}
.gallery-thumbs{
  display:flex;
  gap:6px;
  margin-top:8px;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
  padding-bottom:4px;
}
@media(min-width:768px){
  .gallery-thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;overflow:visible}
}
.thumb{
  flex:0 0 64px;
  aspect-ratio:1;
  background:var(--bg-soft);
  border:1.5px solid transparent;
  cursor:pointer;
  position:relative;
  transition:border-color 0.2s;
  overflow:hidden;
}
@media(min-width:768px){.thumb{flex:0 0 auto}}
.thumb.active{border-color:var(--brand-red)}
.thumb img{width:100%;height:100%;object-fit:cover}
.thumb.video::after{content:"▶";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;background:rgba(0,0,0,0.35)}
@media(min-width:980px){
  .gallery{position:sticky;top:90px;height:fit-content;align-self:start}
}

/* === Product info === */
.product-tag{
  font-size:10px;
  letter-spacing:0.14em;
  text-transform:uppercase;
  color:var(--brand-red);
  font-weight:600;
  margin-bottom:6px;
}
.info h1{
  font-family:'Poppins',sans-serif;
  font-size:22px;
  line-height:1.25;
  font-weight:500;
  margin-bottom:10px;
  color:var(--ink);
  letter-spacing:-0.01em;
}
@media(min-width:768px){.info h1{font-size:28px}}

.subhead{
  font-size:12px;
  color:var(--ink-3);
  margin-bottom:14px;
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:8px;
}
.subhead .stars{color:#f5a623;font-size:13px;letter-spacing:0.05em}
.subhead .stars-num{color:var(--ink);font-weight:600}
.subhead .pipe{color:var(--line)}
.subhead a{color:var(--ink-3);border-bottom:1px solid var(--line)}

.spec-chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:20px}
.chip{
  display:inline-flex;
  align-items:center;
  font-size:10.5px;
  letter-spacing:0.04em;
  background:var(--bg-pale);
  color:var(--brand-red);
  padding:5px 10px;
  border-radius:var(--radius-pill);
  font-weight:600;
  text-transform:uppercase;
}

/* === Live viewers === */
.live-viewers{
  background:var(--bg-soft);
  padding:9px 12px;
  margin-bottom:18px;
  font-size:12px;
  color:var(--ink-2);
  display:flex;
  align-items:center;
  gap:8px;
  border-left:3px solid var(--brand-red);
}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--brand-red);animation:pulse 2s ease-in-out infinite;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}

/* === Price block === */
.price-block{
  padding:18px 0;
  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);
  margin-bottom:20px;
}
.price-row{display:flex;align-items:baseline;gap:12px;margin-bottom:6px;flex-wrap:wrap}
.price-now{font-size:26px;font-weight:600;letter-spacing:-0.01em;color:var(--sale-red)}
@media(min-width:768px){.price-now{font-size:30px}}
.price-was{font-size:14px;color:var(--ink-3);text-decoration:line-through}
.price-save-tag{
  font-size:11px;
  font-weight:600;
  background:var(--success-bright);
  color:#fff;
  padding:3px 9px;
  border-radius:var(--radius-pill);
  letter-spacing:0.02em;
  display:inline-flex;
  align-items:center;
  gap:3px;
}
.price-save-tag::before{content:"↓";font-weight:700}
.price-savings{display:flex;gap:14px;flex-wrap:wrap;margin-top:8px;font-size:12px;color:var(--success);font-weight:500}
.price-savings span::before{content:"✓ ";font-weight:bold}
.price-note{font-size:11px;color:var(--ink-3);margin-top:6px}

/* === Variants === */
.variant{margin-bottom:18px}
.variant-label{
  font-size:12px;
  color:var(--ink-2);
  font-weight:500;
  margin-bottom:8px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8px;
}
.variant-label .selected{color:var(--ink);font-weight:600}
.variant-label .help{
  color:var(--brand-red);
  font-size:11px;
  font-weight:500;
  border-bottom:1px solid var(--brand-red);
}
/* === Metal/karat cards — Lucira exact: gradient swatch + 2-line label + green active dot === */
.metal-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}
@media(min-width:480px){.metal-grid{grid-template-columns:repeat(4,1fr)}}
@media(min-width:768px){.metal-grid{grid-template-columns:repeat(3,1fr)}}
.opt-metal{
  border:1px solid var(--line);
  background:var(--bg-card);
  padding:12px 8px;
  cursor:pointer;
  transition:all 0.18s;
  text-align:center;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:8px;
  border-radius:var(--radius-lg);
  font-family:inherit;
  position:relative;
  min-height:88px;
}
.opt-metal:hover{border-color:var(--ink-3)}
.opt-metal.active{
  border-color:var(--brand-red);
  background:#fff;
  box-shadow:0 0 0 1px var(--brand-red), 0 1px 3px rgba(0,0,0,0.04);
}
.opt-metal.active::before{
  content:"";
  position:absolute;
  top:8px;
  left:8px;
  width:6px;
  height:6px;
  border-radius:50%;
  background:var(--success-bright);
}

/* Gold gradient swatches — 28x28 circles */
.metal-swatch{
  width:28px;
  height:28px;
  border-radius:50%;
  border:1px solid rgba(0,0,0,0.06);
  box-shadow:inset 0 0 4px rgba(0,0,0,0.08);
  flex-shrink:0;
}
.metal-swatch.yellow{background:linear-gradient(147.45deg, #c59922 17.98%, #ead59e 48.14%, #c59922 83.84%)}
.metal-swatch.rose{background:linear-gradient(147.45deg, #c98675 17.98%, #f5cab8 48.14%, #c98675 83.84%)}
.metal-swatch.white{background:linear-gradient(147.45deg, #c4c4c4 17.98%, #ededed 48.14%, #c4c4c4 83.84%)}

.opt-metal .karat{
  font-size:13px;
  font-weight:500;
  color:var(--ink);
  letter-spacing:0;
  line-height:1.15;
  text-transform:uppercase;
}
.opt-metal .metal-label{
  font-size:10.5px;
  font-weight:400;
  color:var(--ink-2);
  letter-spacing:0.02em;
  line-height:1.15;
  text-transform:uppercase;
}
.opt-metal .stack{display:flex;flex-direction:column;gap:2px;align-items:center}
.opt-metal.active .karat{font-weight:600}

/* === Size chips — Lucira exact: 40px, 8px rounded, green dot when active === */
.size-grid{
  display:grid;
  grid-template-columns:repeat(7,1fr);
  gap:8px;
}
@media(min-width:480px){.size-grid{grid-template-columns:repeat(7,1fr)}}
.opt-size{
  border:1px solid var(--line);
  background:#fff;
  cursor:pointer;
  transition:all 0.18s;
  min-height:40px;
  height:40px;
  text-align:center;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:14px;
  font-weight:400;
  color:var(--ink);
  border-radius:var(--radius-md);
  font-family:inherit;
  padding:0 2px;
  position:relative;
}
.opt-size:hover{border-color:var(--ink-3)}
.opt-size.active{
  border-color:var(--brand-red);
  background:#fff;
  box-shadow:0 0 0 1px var(--brand-red);
  color:var(--ink);
  font-weight:700;
}
.opt-size.active::before{
  content:"";
  position:absolute;
  top:4px;
  left:4px;
  width:6px;
  height:6px;
  border-radius:50%;
  background:var(--success-bright);
}
.opt-size.unavailable{
  color:var(--ink-4);
  background:var(--bg-soft);
  cursor:not-allowed;
  position:relative;
}
.opt-size.unavailable::after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(to top right, transparent calc(50% - 0.5px), var(--ink-4) 50%, transparent calc(50% + 0.5px));
}

/* Section heading in PDP right column (mimics Lucira's SIZE & CUSTOMIZATION) */
.pdp-section-head{
  font-size:11px;
  letter-spacing:0.14em;
  text-transform:uppercase;
  font-weight:700;
  color:var(--ink);
  padding:18px 0 12px;
  margin-top:6px;
  border-top:1px solid var(--line);
}

/* Collapsible info panels (Warranty / Care / Package) */
.info-accordion{margin-bottom:6px;border:1px solid var(--line);background:#fff}
.info-accordion-head{
  padding:14px 16px;
  font-weight:600;
  font-size:13px;
  color:var(--ink);
  display:flex;
  justify-content:space-between;
  align-items:center;
  cursor:pointer;
  min-height:48px;
}
.info-accordion-head::after{content:"+";color:var(--brand-red);font-size:20px;font-weight:300;transition:transform 0.2s}
.info-accordion.open .info-accordion-head::after{content:"−"}
.info-accordion-body{display:none;padding:0 16px 16px;color:var(--ink-2);font-size:13px;line-height:1.7}
.info-accordion.open .info-accordion-body{display:block;border-top:1px solid var(--line);padding-top:14px}

/* Same Collection / Recently Viewed — horizontal scroll on mobile */
.h-scroll{
  display:grid;
  grid-auto-flow:column;
  grid-auto-columns:48%;
  gap:10px;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
  padding-bottom:8px;
  scroll-snap-type:x mandatory;
}
.h-scroll > *{scroll-snap-align:start}
@media(min-width:560px){.h-scroll{grid-auto-columns:32%}}
@media(min-width:780px){.h-scroll{grid-auto-columns:23%}}
@media(min-width:980px){.h-scroll{grid-auto-columns:19%}}

/* Explore Our Range tiles */
.explore-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
}
@media(min-width:560px){.explore-grid{grid-template-columns:repeat(4,1fr)}}
@media(min-width:780px){.explore-grid{grid-template-columns:repeat(8,1fr)}}
.explore-tile{
  background:#fff;
  border:1px solid var(--line);
  padding:16px 8px;
  text-align:center;
  cursor:pointer;
  transition:all 0.2s;
  border-radius:8px;
  min-height:84px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:6px;
}
.explore-tile:hover{border-color:var(--brand-red);transform:translateY(-2px)}
.explore-icon{font-size:22px;color:var(--brand-red)}
.explore-label{font-size:12px;font-weight:500;color:var(--ink)}

/* Full-width store finder */
.store-finder{
  background:#fff;
  border:1px solid var(--line);
  padding:18px;
  border-radius:8px;
}
.store-finder-head{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap}
.store-finder-pin{
  display:flex;
  gap:6px;
  background:var(--bg-soft);
  padding:5px;
  flex:1;
  min-width:200px;
  max-width:340px;
  border-radius:8px;
}
.store-finder-pin input{
  flex:1;
  border:none;
  padding:8px 10px;
  font-family:inherit;
  font-size:13px;
  background:transparent;
  outline:none;
  min-height:40px;
}
.store-finder-pin button{
  padding:8px 16px;
  font-size:11.5px;
  letter-spacing:0.04em;
  font-weight:600;
  background:var(--ink);
  color:#fff;
  border-radius:var(--radius-pill);
  text-transform:uppercase;
}
.store-card-grid{display:grid;grid-template-columns:1fr;gap:10px;margin-top:14px}
@media(min-width:680px){.store-card-grid{grid-template-columns:1fr 1fr}}
.store-card{
  border:1px solid var(--line);
  padding:16px;
  border-radius:8px;
  background:#fff;
  display:flex;
  flex-direction:column;
  gap:10px;
}
.store-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.store-card-name{font-weight:600;font-size:14px;color:var(--ink);margin-bottom:2px}
.store-card-status{
  font-size:9.5px;
  letter-spacing:0.05em;
  padding:3px 8px;
  border-radius:var(--radius-pill);
  font-weight:600;
  text-transform:uppercase;
  flex-shrink:0;
  white-space:nowrap;
  height:fit-content;
}
.store-card-status.in-stock{background:var(--success-pale);color:var(--success)}
.store-card-status.ships-from{background:var(--warn-pale);color:var(--warn)}
.store-card-addr{font-size:11.5px;color:var(--ink-3);line-height:1.5}
.store-card-meta{font-size:11px;color:var(--ink-2);display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.store-card-meta b{color:var(--ink);font-weight:600}
.store-card-actions{display:flex;gap:6px;margin-top:6px}
.store-card-btn{
  flex:1;
  padding:9px;
  font-size:10.5px;
  letter-spacing:0.04em;
  text-align:center;
  border:1px solid var(--ink);
  color:var(--ink);
  font-weight:600;
  text-transform:uppercase;
  border-radius:var(--radius-pill);
  background:#fff;
  cursor:pointer;
  min-height:38px;
}
.store-card-btn.primary{background:var(--brand-red);color:#fff;border-color:var(--brand-red)}
.store-card-btn:hover{background:var(--ink);color:#fff}
.store-card-btn.primary:hover{background:var(--brand-red-dark)}

/* Newsletter signup */
.newsletter{
  background:linear-gradient(135deg, var(--bg-pale) 0%, var(--bg-soft) 100%);
  padding:40px 24px;
  text-align:center;
  border-radius:8px;
}
.newsletter h2{font-size:22px;margin-bottom:8px}
.newsletter p{color:var(--ink-2);font-size:13.5px;margin-bottom:20px;max-width:480px;margin-left:auto;margin-right:auto}
.newsletter-form{
  display:flex;
  gap:6px;
  max-width:420px;
  margin:0 auto;
  background:#fff;
  border:1px solid var(--line-2);
  padding:5px;
  border-radius:var(--radius-pill);
}
.newsletter-form input{
  flex:1;
  border:none;
  padding:10px 14px;
  font-family:inherit;
  font-size:13px;
  background:transparent;
  outline:none;
  min-height:42px;
}
.newsletter-form button{
  padding:10px 22px;
  font-size:11.5px;
  letter-spacing:0.06em;
  font-weight:600;
  background:var(--brand-red);
  color:#fff;
  border-radius:var(--radius-pill);
  text-transform:uppercase;
  white-space:nowrap;
}
.newsletter small{display:block;color:var(--ink-3);font-size:10.5px;margin-top:10px}

.size-helper{font-size:11.5px;color:var(--ink-3);margin-top:8px;line-height:1.6}
.size-helper a{color:var(--brand-red);border-bottom:1px solid var(--brand-red);font-weight:500}

/* === Engraving === */
.engrave{
  background:var(--bg-pale);
  padding:12px 14px;
  margin-bottom:18px;
  display:flex;
  align-items:flex-start;
  gap:10px;
  font-size:12.5px;
  border-left:3px solid var(--brand-red);
}
.engrave-icon{font-size:18px;line-height:1;color:var(--brand-red)}
.engrave-body{flex:1}
.engrave-body b{display:block;margin-bottom:2px;font-weight:600;color:var(--ink)}
.engrave-body input{
  margin-top:8px;
  width:100%;
  border:1px solid var(--line-2);
  background:#fff;
  padding:9px 12px;
  font-family:inherit;
  font-size:13px;
  min-height:40px;
}
.engrave-body input:focus{outline:none;border-color:var(--brand-red)}

/* === Delivery + Pincode === */
.deliver-bar{
  background:var(--success-pale);
  color:var(--success);
  font-size:12.5px;
  padding:10px 12px;
  margin-bottom:12px;
  display:flex;
  align-items:flex-start;
  gap:8px;
  line-height:1.45;
}
.deliver-bar b{font-weight:600}

.pincode{
  display:flex;
  gap:6px;
  background:#fff;
  border:1px solid var(--line-2);
  padding:4px;
  margin-bottom:18px;
  align-items:stretch;
}
.pincode input{
  flex:1;
  border:none;
  padding:8px 10px;
  font-family:inherit;
  font-size:13px;
  background:transparent;
  outline:none;
  min-height:38px;
}
.pincode button{
  padding:8px 18px;
  font-size:11.5px;
  letter-spacing:0.04em;
  font-weight:600;
  background:var(--ink);
  color:#fff;
  border-radius:var(--radius-pill);
  text-transform:uppercase;
  white-space:nowrap;
}

/* === CTAs — Lucira spec: h-14 (56px), rounded-sm (2px), uppercase, tracking-wider === */
.cta-stack{display:flex;flex-direction:column;gap:8px;margin-bottom:6px}
.cta-row{display:grid;grid-template-columns:1fr;gap:8px}
@media(min-width:520px){.cta-row{grid-template-columns:1.6fr 1fr}}
.btn{
  padding:0 22px;
  font-size:13px;
  letter-spacing:0.08em;
  font-weight:700;
  text-transform:uppercase;
  transition:all 0.2s;
  text-align:center;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  border-radius:var(--radius-sm);
  height:56px;
  cursor:pointer;
  border:1.5px solid transparent;
  line-height:1;
}
.btn-primary{background:var(--brand-red);color:#fff;border-color:var(--brand-red)}
.btn-primary:hover{background:var(--brand-red-dark);border-color:var(--brand-red-dark)}
.btn-scheme{
  background:#fff;
  color:var(--brand-red);
  border-color:var(--brand-red);
  font-size:11.5px;
  padding:0 14px;
  flex-direction:column;
  gap:0;
  line-height:1.15;
}
.btn-scheme b{font-size:13px;font-weight:700;display:block;letter-spacing:0.06em}
.btn-scheme:hover{background:rgba(191,19,4,0.05)}
.btn-secondary{background:#fff;color:var(--ink);border:1.5px solid var(--ink);height:48px;font-size:12px;border-radius:var(--radius-pill)}
.btn-secondary:hover{background:var(--ink);color:#fff}
.cta-helper{font-size:11px;color:var(--ink-3);margin:8px 0 16px;text-align:center;line-height:1.5}

/* === Trust strip === */
.trust-strip{
  border:1px solid var(--line);
  background:#fff;
  padding:4px 12px;
  margin-bottom:16px;
}
.trust-row{
  display:flex;
  align-items:center;
  gap:12px;
  padding:11px 0;
  border-bottom:1px solid var(--line);
  font-size:12.5px;
}
.trust-row:last-child{border-bottom:none}
.trust-icon{
  flex-shrink:0;
  width:32px;
  height:32px;
  background:var(--bg-pale);
  color:var(--brand-red);
  border-radius:50%;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  font-weight:bold;
  font-size:14px;
}
.trust-body{flex:1;min-width:0}
.trust-body b{display:block;font-weight:600;margin-bottom:1px;color:var(--ink);font-size:12.5px}
.trust-body span{color:var(--ink-3);font-size:11.5px;line-height:1.45}

/* === Perks === */
.perk-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:6px;
  margin-bottom:18px;
}
@media(min-width:480px){.perk-grid{grid-template-columns:1fr 1fr}}
.perk{
  background:#fff;
  border:1px solid var(--line);
  padding:11px 13px;
  font-size:12px;
  line-height:1.5;
}
.perk b{
  display:block;
  color:var(--brand-red);
  font-weight:600;
  margin-bottom:3px;
  font-size:10px;
  letter-spacing:0.08em;
  text-transform:uppercase;
}
.perk strong{font-weight:600;color:var(--ink)}
.perk a{display:inline-block;margin-top:4px;color:var(--ink);border-bottom:1px solid var(--ink-3);font-size:11.5px}

/* === Store availability === */
.store-block{
  margin-bottom:20px;
  border:1px solid var(--line);
  background:#fff;
  overflow:hidden;
}
.store-head{
  padding:12px 14px;
  border-bottom:1px solid var(--line);
  display:flex;
  align-items:center;
  justify-content:space-between;
  font-size:12.5px;
  flex-wrap:wrap;
  gap:6px;
}
.store-head b{font-weight:600;color:var(--ink)}
.store-head .nearest{color:var(--success);font-size:11px;font-weight:500}
.store-list{padding:4px 0}
.store-item{
  padding:10px 14px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  font-size:12.5px;
  border-bottom:1px solid var(--line);
}
.store-item:last-child{border-bottom:none}
.store-info{flex:1;min-width:0}
.store-name{font-weight:500;color:var(--ink);font-size:12.5px;line-height:1.35}
.store-meta{color:var(--ink-3);font-size:10.5px;margin-top:2px}
.store-status{
  font-size:10px;
  letter-spacing:0.04em;
  padding:3px 9px;
  border-radius:var(--radius-pill);
  font-weight:600;
  text-transform:uppercase;
  flex-shrink:0;
  white-space:nowrap;
}
.store-status.in-stock{background:var(--success-pale);color:var(--success)}
.store-status.ships-from{background:var(--warn-pale);color:var(--warn)}
.store-cta-row{display:flex;gap:6px;padding:10px 14px;border-top:1px solid var(--line);background:var(--bg-soft)}
.store-cta{
  flex:1;
  padding:11px;
  font-size:11px;
  letter-spacing:0.04em;
  text-align:center;
  border:1px solid var(--ink);
  background:#fff;
  color:var(--ink);
  font-weight:600;
  text-transform:uppercase;
  border-radius:var(--radius-pill);
  min-height:42px;
  cursor:pointer;
}
.store-cta:hover{background:var(--ink);color:#fff}

/* === Sections === */
section.block{padding:40px 0;border-top:1px solid var(--line)}
@media(min-width:768px){section.block{padding:56px 0}}
section.block h2{
  font-family:'Poppins',sans-serif;
  font-size:20px;
  font-weight:500;
  margin-bottom:6px;
  letter-spacing:-0.005em;
  line-height:1.25;
  color:var(--ink);
}
@media(min-width:768px){section.block h2{font-size:26px}}
section.block .lead{color:var(--ink-2);font-size:13.5px;margin-bottom:24px;max-width:600px;line-height:1.6}
@media(min-width:768px){section.block .lead{font-size:14.5px;margin-bottom:30px}}

/* === Story === */
.story{display:grid;grid-template-columns:1fr;gap:24px;align-items:start}
@media(min-width:780px){.story{grid-template-columns:1fr 1fr;gap:40px}}
.story-block{margin-bottom:24px}
.story-block:last-child{margin-bottom:0}
.story-tag{
  font-size:10px;
  letter-spacing:0.14em;
  text-transform:uppercase;
  color:var(--brand-red);
  font-weight:600;
  margin-bottom:6px;
}
.story-block h3{
  font-family:'Poppins',sans-serif;
  font-size:17px;
  font-weight:600;
  margin-bottom:8px;
  color:var(--ink);
}
@media(min-width:768px){.story-block h3{font-size:18px}}
.story-block p{color:var(--ink-2);font-size:13.5px;line-height:1.7;margin-bottom:8px}

/* === Specs grouped (Lucira-style) === */
.spec-wrap{background:#fff;border:1px solid var(--line);overflow:hidden}
.spec-sku{padding:14px 18px;border-bottom:1px solid var(--line);font-size:12px;color:var(--ink-3);background:var(--bg-soft);letter-spacing:0.02em}
.spec-sku b{color:var(--ink);font-weight:600;letter-spacing:0.04em}
.spec-group{border-bottom:1px solid var(--line)}
.spec-group:last-child{border-bottom:none}
.spec-group-title{
  padding:13px 18px 6px;
  font-size:11px;
  letter-spacing:0.14em;
  text-transform:uppercase;
  font-weight:700;
  color:var(--brand-red);
}
.spec-fields{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:0;
  padding:0 6px 12px;
}
@media(min-width:560px){.spec-fields{grid-template-columns:repeat(3,1fr)}}
@media(min-width:768px){.spec-fields{grid-template-columns:repeat(4,1fr)}}
.spec-field{padding:8px 12px}
.spec-field dt{font-size:10.5px;color:var(--ink-3);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:3px;font-weight:500}
.spec-field dd{font-size:13.5px;color:var(--ink);font-weight:500;line-height:1.35}

/* Legacy spec table styles (kept for any other use) */
.spec-table{background:#fff;border:1px solid var(--line);overflow:hidden}

/* === Price details toggle (Lucira-style) === */
.price-details{
  margin-bottom:18px;
  border:1px solid var(--line);
  background:#fff;
  overflow:hidden;
}
.price-details-head{
  padding:13px 16px;
  font-size:11px;
  letter-spacing:0.14em;
  text-transform:uppercase;
  font-weight:700;
  color:var(--ink);
  background:var(--bg-soft);
  border-bottom:1px solid var(--line);
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.price-details-head::after{content:"−";color:var(--brand-red);font-size:18px;font-weight:300;transition:transform 0.2s}
.price-details.collapsed .price-details-head::after{content:"+"}
.price-details.collapsed .price-details-body{display:none}
.price-tabs{
  display:flex;
  background:var(--bg-soft);
  border-bottom:1px solid var(--line);
}
.price-tab{
  flex:1;
  padding:11px 12px;
  font-size:12px;
  font-weight:600;
  text-align:center;
  color:var(--ink-3);
  border:none;
  background:transparent;
  cursor:pointer;
  letter-spacing:0.02em;
  position:relative;
  transition:color 0.2s;
}
.price-tab:hover{color:var(--ink)}
.price-tab.active{color:var(--brand-red);background:#fff}
.price-tab.active::after{
  content:"";
  position:absolute;
  bottom:-1px;
  left:0;
  right:0;
  height:2px;
  background:var(--brand-red);
}
.price-panel{display:none;padding:8px 0}
.price-panel.active{display:block}
.price-line{
  display:grid;
  grid-template-columns:1.6fr auto auto;
  gap:8px;
  align-items:center;
  padding:9px 16px;
  font-size:12.5px;
  border-bottom:1px solid var(--line);
}
.price-line:last-child{border-bottom:none}
.price-line.total{
  background:var(--bg-soft);
  font-weight:600;
  font-size:13.5px;
  color:var(--ink);
  padding:13px 16px;
}
.price-line.savings{
  background:var(--bg-pale);
  color:var(--brand-red);
  font-weight:600;
  padding:11px 16px;
  font-size:12.5px;
  border-top:1px dashed var(--line-2);
}
.pl-label{color:var(--ink-2)}
.pl-label .sub{display:block;font-size:10.5px;color:var(--ink-3);margin-top:1px;font-weight:400}
.pl-strike{
  font-size:11.5px;
  color:var(--ink-3);
  text-decoration:line-through;
  text-align:right;
}
.pl-value{
  font-size:13px;
  color:var(--ink);
  font-weight:600;
  text-align:right;
  white-space:nowrap;
}
.pl-discount{
  font-size:9.5px;
  background:var(--brand-red);
  color:#fff;
  padding:2px 6px;
  border-radius:var(--radius-pill);
  font-weight:600;
  letter-spacing:0.04em;
  margin-left:6px;
  white-space:nowrap;
}
.price-line.total .pl-value{color:var(--ink);font-size:15px}
.price-tax-note{padding:8px 16px;font-size:10.5px;color:var(--ink-3);font-style:italic;background:var(--bg-soft);border-top:1px solid var(--line)}

/* Price comparison styles */
.compare-row-card{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:14px 16px;
  border-bottom:1px solid var(--line);
  gap:14px;
}
.compare-row-card:last-child{border-bottom:none}
.compare-row-card.you{background:var(--bg-pale);border-left:3px solid var(--brand-red)}
.cr-info{flex:1;min-width:0}
.cr-name{font-size:13px;font-weight:600;color:var(--ink);margin-bottom:2px}
.cr-info.you .cr-name{color:var(--brand-red)}
.cr-meta{font-size:10.5px;color:var(--ink-3);line-height:1.4}
.cr-price{font-size:14px;font-weight:600;color:var(--ink);white-space:nowrap;text-align:right}
.cr-price .save{display:block;font-size:10px;color:var(--success);margin-top:2px;font-weight:500}
.compare-note{padding:11px 16px;font-size:11px;color:var(--ink-3);background:var(--bg-soft);font-style:italic;line-height:1.5}

/* === Process === */
.process{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:6px;
  margin-top:24px;
}
@media(min-width:560px){.process{grid-template-columns:repeat(4,1fr)}}
@media(min-width:980px){.process{grid-template-columns:repeat(7,1fr)}}
.process-step{
  text-align:center;
  padding:14px 8px;
  background:#fff;
  border:1px solid var(--line);
}
.process-num{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:28px;
  height:28px;
  border-radius:50%;
  background:var(--brand-red);
  color:#fff;
  font-weight:600;
  font-size:12px;
  margin-bottom:8px;
}
.process-step b{display:block;font-size:12.5px;font-weight:600;margin-bottom:3px;color:var(--ink)}
.process-step span{font-size:11px;color:var(--ink-3);line-height:1.4}

/* === Compare table === */
.compare-table{background:#fff;border:1px solid var(--line);overflow:hidden;margin-top:18px}
.compare-head{
  display:grid;
  grid-template-columns:1.4fr 1fr 1fr;
  background:var(--bg-soft);
  font-size:10.5px;
  letter-spacing:0.04em;
  font-weight:600;
  text-transform:uppercase;
}
.compare-head div{padding:10px 12px;border-right:1px solid var(--line);color:var(--ink-2)}
.compare-head div:last-child{border-right:none}
.compare-head div.tag-lab{background:var(--bg-pale);color:var(--brand-red)}
.compare-row{display:grid;grid-template-columns:1.4fr 1fr 1fr;font-size:12.5px;border-top:1px solid var(--line)}
.compare-row div{padding:10px 12px;border-right:1px solid var(--line);color:var(--ink-2);display:flex;align-items:center}
.compare-row div:last-child{border-right:none}
.compare-row div:first-child{color:var(--ink);font-weight:500}
.compare-row .tick{font-size:16px;font-weight:bold;justify-content:center;text-align:center}
.compare-row .tick.yes{color:var(--success)}
.compare-row .tick.no{color:var(--ink-3)}
@media(min-width:768px){
  .compare-head div, .compare-row div{padding:14px 16px;font-size:13px}
  .compare-head{font-size:11.5px}
}

/* === Certificate === */
.cert-block{
  display:grid;
  grid-template-columns:1fr;
  gap:24px;
  align-items:center;
  background:#fff;
  border:1px solid var(--line);
  padding:20px;
}
@media(min-width:680px){.cert-block{grid-template-columns:240px 1fr;padding:28px;gap:32px}}
.cert-img{
  background:#fff;
  border:1px solid var(--line);
  aspect-ratio:1/1.3;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  text-align:center;
  max-width:240px;
  margin:0 auto;
  width:100%;
}
.cert-img b{font-size:10px;letter-spacing:0.12em;color:var(--brand-red);text-transform:uppercase;display:block;margin-bottom:4px;font-weight:700}
.cert-img h4{font-size:18px;font-weight:600;line-height:1.2;color:var(--ink);margin-bottom:4px}
.cert-img p{font-size:10.5px;color:var(--ink-3)}
.cert-img .crest{
  width:42px;
  height:42px;
  border:2px solid var(--brand-red);
  border-radius:50%;
  margin:14px auto;
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--brand-red);
  font-weight:600;
  font-size:16px;
}
.cert-body h3{font-size:17px;font-weight:600;margin-bottom:10px;color:var(--ink)}
.cert-body p{color:var(--ink-2);margin-bottom:12px;font-size:13px;line-height:1.65}
.cert-body ul{list-style:none;padding:0}
.cert-body li{padding:5px 0;color:var(--ink-2);font-size:13px}
.cert-body li::before{content:"✓ ";color:var(--success);font-weight:bold;margin-right:4px}

/* === Reviews === */
.review-summary{display:grid;grid-template-columns:1fr;gap:20px;margin-bottom:24px}
@media(min-width:780px){.review-summary{grid-template-columns:1fr 1.8fr;gap:32px}}
.review-score{
  text-align:center;
  background:#fff;
  border:1px solid var(--line);
  padding:22px;
}
.review-score .num{font-size:48px;font-weight:600;line-height:1;color:var(--ink)}
.review-score .stars{color:#f5a623;font-size:16px;margin:8px 0 4px;letter-spacing:0.1em}
.review-score .count{color:var(--ink-3);font-size:12px}
.review-bars{padding:6px 0}
.review-bar{
  display:grid;
  grid-template-columns:48px 1fr 38px;
  gap:10px;
  align-items:center;
  margin-bottom:6px;
  font-size:12px;
}
.review-bar .star-label{color:var(--ink-2)}
.review-bar .bar{height:6px;background:var(--bg-soft);overflow:hidden;border-radius:var(--radius-pill)}
.review-bar .bar-fill{height:100%;background:#f5a623}
.review-bar .pct{color:var(--ink-3);font-size:11.5px}
.recommend{
  margin-top:14px;
  text-align:center;
  font-size:12px;
  color:var(--success);
  font-weight:600;
  padding:8px;
  background:var(--success-pale);
}
.review-filters{margin-top:14px;font-size:11.5px;color:var(--ink-3)}
.review-filters a{color:var(--ink-3);margin-right:10px}
.review-filters a.active{color:var(--ink);border-bottom:1px solid var(--ink);padding-bottom:2px}
.review-list{display:grid;grid-template-columns:1fr;gap:12px}
@media(min-width:780px){.review-list{grid-template-columns:1fr 1fr;gap:14px}}
.review-card{background:#fff;border:1px solid var(--line);padding:18px}
.review-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;font-size:12px;gap:10px;flex-wrap:wrap}
.reviewer{display:flex;align-items:center;gap:9px;min-width:0}
.reviewer-avatar{
  width:34px;
  height:34px;
  border-radius:50%;
  background:var(--bg-pale);
  color:var(--brand-red);
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:600;
  font-size:13px;
  flex-shrink:0;
}
.reviewer-name{font-weight:600;font-size:12.5px;color:var(--ink)}
.verified{font-size:9.5px;letter-spacing:0.05em;font-weight:600;color:var(--success);text-transform:uppercase}
.review-stars{color:#f5a623;font-size:12px;letter-spacing:0.05em}
.review-card p{font-size:13px;line-height:1.6;color:var(--ink-2);margin-bottom:8px}
.review-date{color:var(--ink-3);font-size:11px}
.see-all-reviews{
  display:inline-block;
  margin-top:24px;
  font-size:12px;
  letter-spacing:0.04em;
  border-bottom:1.5px solid var(--brand-red);
  color:var(--brand-red);
  font-weight:600;
  padding-bottom:3px;
  text-transform:uppercase;
}

/* === Q&A === */
.qa-list{max-width:760px;margin:0 auto}
.qa-item{background:#fff;border:1px solid var(--line);margin-bottom:6px;overflow:hidden}
.qa-q{
  padding:14px 16px;
  font-weight:600;
  font-size:13.5px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  cursor:pointer;
  color:var(--ink);
  gap:10px;
  min-height:48px;
}
.qa-q::after{content:"+";color:var(--brand-red);font-size:22px;font-weight:300;transition:transform 0.2s;flex-shrink:0}
.qa-item.open .qa-q::after{transform:rotate(45deg)}
