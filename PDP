<script>
/* marquee duplicate for seamless loop */
document.getElementById('mq').innerHTML+=document.getElementById('mq').innerHTML;

/* reveal */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:.1});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

/* subtle parallax on editorial imagery */
(()=>{
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  const imgs=[...document.querySelectorAll('.about-grid .rv')].map(w=>w.querySelector('img')).filter(Boolean);
  if(!imgs.length)return;
  let ticking=false;
  const upd=()=>{
    const vh=innerHeight;
    imgs.forEach(img=>{
      const r=img.getBoundingClientRect();
      if(r.bottom<0||r.top>vh)return;
      const off=((r.top+r.height/2)-vh/2)/vh; // -1..1
      img.style.transform='scale(1.08) translateY('+(off*-18).toFixed(1)+'px)';
    });
    ticking=false;
  };
  addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(upd);}},{passive:true});
  addEventListener('resize',upd,{passive:true});
  upd();
})();

/* gallery */
const gimg=document.getElementById('gimg'),gmain=document.getElementById('gmain');
document.querySelectorAll('.gth').forEach(t=>t.addEventListener('click',()=>{
  document.querySelectorAll('.gth').forEach(x=>x.classList.remove('on'));
  t.classList.add('on');
  gimg.style.opacity=0;
  setTimeout(()=>{gimg.src=t.dataset.src;gimg.style.opacity=1;},180);
  gmain.classList.remove('zoomed');
}));
gmain.addEventListener('click',e=>{
  const z=gmain.classList.toggle('zoomed');
  if(z){const r=gmain.getBoundingClientRect();
    gimg.style.transformOrigin=((e.clientX-r.left)/r.width*100)+'% '+((e.clientY-r.top)/r.height*100)+'%';}
});

/* mobile swipe gallery */
(()=>{
  const track=document.getElementById('mgalTrack'),dots=document.getElementById('mgalDots'),count=document.getElementById('mgalCount');
  const n=track.children.length;
  for(let k=0;k<n;k++){const b=document.createElement('button');if(k===0)b.classList.add('on');b.setAttribute('aria-label','Image '+(k+1));
    b.addEventListener('click',()=>track.scrollTo({left:track.clientWidth*k,behavior:'smooth'}));dots.appendChild(b);}
  let raf;
  track.addEventListener('scroll',()=>{
    cancelAnimationFrame(raf);
    raf=requestAnimationFrame(()=>{
      const i=Math.round(track.scrollLeft/track.clientWidth);
      [...dots.children].forEach((d,j)=>d.classList.toggle('on',j===i));
      count.textContent=(i+1)+' / '+n;
    });
  },{passive:true});
})();

/* more-ways carousel */
(()=>{
  const track=document.getElementById('mwaysTrack');if(!track)return;
  const dots=document.getElementById('mwaysDots'),prev=document.getElementById('mwaysPrev'),next=document.getElementById('mwaysNext');
  const n=track.children.length;
  for(let k=0;k<n;k++){const b=document.createElement('button');if(k===0)b.classList.add('on');b.setAttribute('aria-label','Slide '+(k+1));
    b.addEventListener('click',()=>track.scrollTo({left:track.clientWidth*k,behavior:'smooth'}));dots.appendChild(b);}
  const cur=()=>Math.round(track.scrollLeft/track.clientWidth);
  prev&&prev.addEventListener('click',()=>track.scrollTo({left:track.clientWidth*Math.max(0,cur()-1),behavior:'smooth'}));
  next&&next.addEventListener('click',()=>track.scrollTo({left:track.clientWidth*Math.min(n-1,cur()+1),behavior:'smooth'}));
  let raf;
  track.addEventListener('scroll',()=>{
    cancelAnimationFrame(raf);
    raf=requestAnimationFrame(()=>{
      const i=cur();
      [...dots.children].forEach((d,j)=>d.classList.toggle('on',j===i));
      if(prev)prev.style.opacity=i===0?'.4':'1';
      if(next)next.style.opacity=i===n-1?'.4':'1';
    });
  },{passive:true});
})();

/* trust carousel */
(()=>{
  const track=document.getElementById('tcarTrack'),dots=document.getElementById('tcarDots');
  if(!track||!dots)return;
  const n=track.children.length;let i=0,timer;
  for(let k=0;k<n;k++){const b=document.createElement('button');if(k===0)b.classList.add('on');b.setAttribute('aria-label','Promise '+(k+1));b.addEventListener('click',()=>{go(k);reset();});dots.appendChild(b);}
  function go(k){i=k;track.style.transform='translateX(-'+(k*100)+'%)';[...dots.children].forEach((d,j)=>d.classList.toggle('on',j===k));}
  function next(){go((i+1)%n);}
  function reset(){clearInterval(timer);timer=setInterval(next,3500);}
  reset();
})();

