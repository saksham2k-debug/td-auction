.opt-l{font-size:11.5px}
.deliv{font-size:12.5px;background:transparent;border:1px solid var(--hairline)}
.deliv svg{stroke:var(--champagne)}
.engrave-h em{background:transparent;color:var(--champagne);padding:0;border:none;border-radius:0;font-size:11px}
@media(max-width:768px){
  .dtile-type{font-size:21px}
  .dtile-grade{font-size:11px}
}

@media(prefers-reduced-motion:reduce){
  .cta1::after{display:none}
  :is(.stories,.prom-grid,.prod-grid,.press-grid,.steps,.vids,.ugc).rv>*,.dtiles-wrap.rv .dtile{opacity:1!important;transform:none!important;transition:none!important}
}

