/* ═══════════════════════════════════════════════════════════════
   LUXURY REFINEMENT — Batches A·B·C·D  (no structure change)
   8pt rhythm · type hierarchy · handcrafted cards · micro-interactions
   ═══════════════════════════════════════════════════════════════ */

/* ── BATCH A · SPACING & RHYTHM (8pt grid) ─────────────────── */
section.blk{padding:clamp(72px,9vw,120px) 0}
.shead{margin:0 auto clamp(48px,6vw,72px)}
.shead .eyebrow{margin-bottom:20px}
.shead h2+p{margin-top:24px}
.hero{gap:clamp(40px,5vw,72px);padding:24px 0 96px}
.crumb{padding:24px 0 0}
/* buy panel — generous, consistent option rhythm */
.pc{padding-top:8px}
.pc h1{margin:16px 0 20px}
.pc-price{margin-bottom:0;padding-bottom:28px}
.pc-jump{margin:24px 0 28px}
.pc-desc{margin-bottom:12px}
.pc-fulldetails{margin-bottom:32px}
.opt{margin-bottom:32px}
.opt-h{margin-bottom:16px}
.engrave{margin:28px 0 32px;padding:24px}
.deliv{padding:16px;margin-bottom:24px}
.cta1{padding:20px}
.book-row{margin-top:16px;gap:12px}
.cta2-sub{margin:16px 0 28px}
.tcar{padding-top:24px}
.dtiles-wrap{margin-bottom:0}
.dtile{padding:24px 8px}
.pol{margin-top:40px}
.pq{padding:24px 0}
.about-grid{gap:clamp(40px,5vw,80px);margin-bottom:clamp(48px,6vw,72px)}
.stcell{padding:32px 28px}
.prom{padding:40px 32px}
.rcard{padding:28px 0;gap:20px}
.store{padding:28px}
.mlux-body{padding:40px 44px 44px}
.fgrid{gap:48px;padding-bottom:48px}
.fbot{padding-top:28px}

/* ── BATCH B · TYPOGRAPHY HIERARCHY ────────────────────────── */
.shead h2{font-size:clamp(38px,4.6vw,60px);line-height:1.04;letter-spacing:-.02em}
.shead p{font-size:16px;line-height:1.85;color:var(--smoke)}
.pc h1{font-size:clamp(30px,3.4vw,42px);line-height:1.08;letter-spacing:-.015em}
.pc-price .now{font-size:clamp(30px,2.6vw,36px);letter-spacing:-.01em}
.pc-desc{font-size:15px;line-height:1.8}
.opt-l{letter-spacing:.22em}
.about-grid h2{font-size:clamp(32px,3.4vw,46px);line-height:1.06;letter-spacing:-.02em}
.about-grid>div>p{font-size:16px;line-height:1.9}
.stcell h4,.prom h4,.store h4,.vid h5,.step h5{letter-spacing:-.005em}
.fq{font-size:clamp(19px,1.9vw,23px);line-height:1.25}
.mlux-body h3{font-size:clamp(28px,3vw,36px);line-height:1.06}
.newsletter h3{font-size:clamp(26px,3vw,36px)}
.rcard .rq{font-size:15px;line-height:1.75}
.rev-list .rcard:first-child .rq{font-size:17px;line-height:1.7}

/* ── BATCH C · CARDS · BORDERS · IMAGE TREATMENT ───────────── */
:root{--shadow:0 22px 48px -30px rgba(24,20,16,.28);--shadow-lift:0 30px 60px -32px rgba(24,20,16,.36)}
.hairline,.pc-jump .gjump-card,.deliv,.engrave,.store,.rev-score{border-color:var(--hairline)}
/* one restrained floating-shadow system */
.gmain{box-shadow:0 40px 80px -48px rgba(24,20,16,.45)}
.cert-mock{box-shadow:0 40px 90px -50px rgba(24,20,16,.5)}
.pcard .pimg,.rel-img,.vid .vimg,.about-grid img,.ugc>div,.mgal-slide{box-shadow:0 18px 40px -34px rgba(24,20,16,.4)}
.store{box-shadow:none;transition:border-color .35s var(--ease),box-shadow .35s var(--ease),transform .35s var(--ease)}
.store:hover{box-shadow:var(--shadow);transform:translateY(-3px)}
/* consistent portrait ratios for editorial imagery */
.pcard .pimg{aspect-ratio:4/5}
.vid .vimg{aspect-ratio:4/5}
/* image hover zoom (clipped) */
.pcard .pimg,.rel-img{overflow:hidden}
.pcard .pimg img,.rel-img img{transition:transform .8s var(--ease)}
.pcard:hover .pimg img{transform:scale(1.05)}
/* thin internal divider for product cards */
.pcard h4{margin-top:16px}
.pcard .pp{margin-top:8px;position:relative;padding-top:12px}
.pcard .pp::before{content:"";position:absolute;top:0;left:0;width:22px;height:1px;background:var(--champagne);opacity:.6}
/* premium jump cards */
.pcj{transition:background .35s var(--ease),transform .35s var(--ease),box-shadow .35s var(--ease)}
.pcj:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
/* diamond tiles — softer selected state + hairline rhythm */
.dtile{transition:background .3s var(--ease),box-shadow .3s var(--ease)}
.dtile.sel{box-shadow:var(--shadow)}
.dtile-breakup .brk td{border-color:var(--hairline)}
/* gallery + more-ways image zoom */
.mlux-img img{transition:transform 1s var(--ease)}
.mlux:hover .mlux-img img{transform:scale(1.05)}

/* ── BATCH D · BUTTONS & MICRO-INTERACTIONS ────────────────── */
/* primary — lift + existing sheen */
.cta1{transition:background .3s var(--ease),transform .25s var(--ease),box-shadow .3s var(--ease);box-shadow:0 12px 30px -18px rgba(24,20,16,.5)}
.cta1:hover{transform:translateY(-2px);box-shadow:0 20px 40px -20px rgba(24,20,16,.55)}
.cta1:active{transform:translateY(0)}
/* secondary/outline — elegant fill wipe */
.book-btn,.cta2{transition:color .35s var(--ease),border-color .35s var(--ease),background .35s var(--ease),transform .25s var(--ease)}
.book-btn:hover,.cta2:hover{transform:translateY(-2px)}
/* nav underline already animates; refine link + range hovers */
.range a,.stores-filter button,.rev-filters button{transition:background .3s var(--ease),color .3s var(--ease),border-color .3s var(--ease),transform .25s var(--ease)}
.range a:hover{transform:translateY(-2px)}
/* smoother FAQ / accordion easing */
.pa,.fa{transition:max-height .45s var(--ease)}
.pq span,.fq span{transition:transform .4s var(--ease)}
/* sticky ATC — elegant entrance */
.dsticky{transition:transform .5s var(--ease),opacity .5s var(--ease)}
.msticky{transition:transform .45s var(--ease)}
/* icon consistency — 1.5px stroke, champagne accents stay hairline */
.ic,.trow svg,.deliv svg,.tcar-slide svg,.cert-txt li::before,.book-btn svg{stroke-width:1.5}
/* restrained sparkle on the rating stars (very subtle) */
@keyframes tdShimmer{0%,92%,100%{opacity:1}96%{opacity:.55}}
.pc-rating .stars,.rev-score .stars{animation:tdShimmer 6s ease-in-out infinite}

/* ── mobile: preserve rhythm without cramping ──────────────── */
@media(max-width:768px){
  section.blk{padding:clamp(56px,12vw,80px) 0}
  .shead{margin-bottom:clamp(36px,9vw,48px)}
  .opt{margin-bottom:28px}
  .mlux-body{padding:28px 24px 30px}
  .stcell{padding:28px 24px}
  .store{padding:24px}
  .cta1:hover,.book-btn:hover,.cta2:hover,.pcj:hover,.store:hover,.range a:hover{transform:none}
}
/* ═══ DECLUTTER PASS — calmer, de-boxed, more air ═══ */
/* atmospheric lede under title */
.pc-lede{font-family:var(--display,'Fraunces');font-size:16px;line-height:1.7;color:var(--smoke);margin:0 0 24px;max-width:42ch}
.pc-price{margin-bottom:20px;padding-bottom:24px;border-bottom:1px solid var(--hairline)}
.pc-price .off{font-size:11.5px;color:var(--smoke)}
/* single quiet reviews/faqs line */
.pc-links{display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-size:12.5px;letter-spacing:.02em;margin:0 0 30px}
.pc-links a{color:var(--noir);border-bottom:1px solid transparent;transition:border-color .25s}
.pc-links a:hover{border-color:var(--hairline-dk)}
.pc-links .pcl-stars{color:var(--champagne);letter-spacing:1px;margin-right:2px}
.pc-links .pcl-sep{color:var(--hairline-dk)}
.pc-links .pcl-details{margin-left:auto;color:var(--smoke);letter-spacing:.1em;text-transform:uppercase;font-size:10.5px}

/* de-box engraving + delivery */
.engrave{border:none!important;background:transparent!important;padding:0!important;margin:8px 0 28px!important;border-top:1px solid var(--hairline)!important;padding-top:24px!important}
.deliv{border:none!important;background:transparent!important;padding:0!important;color:var(--smoke)}
.deliv svg{stroke:var(--champagne)}

/* de-box diamond tiles → hairline rows only */
.dtile{border:none!important;border-bottom:1px solid var(--hairline)!important;background:transparent!important;box-shadow:none!important;border-radius:0!important;padding:26px 4px 26px 20px!important;position:relative}
.dtiles{border-top:1px solid var(--hairline)}
.dtile.sel{background:transparent!important}
.dtile::before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--champagne);transform:scaleY(0);transform-origin:center;transition:transform .35s var(--ease)}
.dtile.sel::before{transform:scaleY(1)}
.dtile-breakup .brk td{border-color:var(--hairline);padding:11px 2px}

/* de-box product cards → floating imagery */
.pcard .pimg{border:none!important;box-shadow:0 20px 44px -34px rgba(24,20,16,.4)}
.pcard .badge{background:rgba(255,255,255,.9);backdrop-filter:blur(4px);border:none}

/* de-box reviews → editorial entries */
.rcard{border:none!important;border-top:1px solid var(--hairline)!important;background:transparent!important;box-shadow:none!important;padding:30px 0!important}
.rev-score{border:1px solid var(--hairline)!important;box-shadow:none!important;background:transparent!important}

/* de-box stores */
.store{border:1px solid var(--hairline)!important;box-shadow:none!important}
.store:hover{border-color:var(--champagne)!important}

/* trim footer keyword wall to one quiet line */
.fsearch p{max-height:3.4em;overflow:hidden;opacity:.7}

/* ═══ BUY-PANEL REWORK (mobile-first) ═══ */
