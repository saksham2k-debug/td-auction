<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mystical Petal 3 Ct Portuguese Solitaire Ring | True Diamond</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,400&family=Jost:wght@300;400;500;600&family=Inter:wght@300;400;500;600&family=Lobster&family=Yellowtail&family=Satisfy&family=ABeeZee&display=swap" rel="stylesheet">
<style>
/* ===== TOKENS (flagship theme) ===== */
:root{
  --gallery:#FCFCFA;--bone:#F4F2EC;--noir:#131211;--smoke:#6E6A63;
  --champagne:#A5854E;--champagne-lt:#EFE7D6;
  --hairline:rgba(19,18,17,.12);--hairline-dk:rgba(19,18,17,.26);
  --ok:#3D7A5C;--ok-bg:#EDF4F0;
  --display:'Cormorant Garamond',Georgia,serif;--ui:'Inter',-apple-system,sans-serif;
  --maxw:1360px;--ease:cubic-bezier(.25,.8,.25,1);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--ui);font-size:14px;color:var(--noir);background:var(--gallery);line-height:1.6;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;font-size:inherit}
input,select{font-family:inherit;font-size:14px;color:var(--noir)}
h1,h2,h3{font-family:var(--display);font-weight:400;line-height:1.08}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 clamp(20px,4vw,56px)}
.eyebrow{font-size:10.5px;letter-spacing:.3em;text-transform:uppercase;font-weight:500;color:var(--champagne)}
:focus-visible{outline:1.5px solid var(--noir);outline-offset:3px}
::selection{background:var(--champagne-lt)}
.rv{opacity:0;transform:translateY(14px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
.rv.in{opacity:1;transform:none}

/* ===== MARQUEE ===== */
.marquee{background:var(--noir);color:rgba(252,252,250,.8);overflow:hidden;white-space:nowrap;padding:10px 0;font-size:11px;letter-spacing:.14em;text-transform:uppercase}
.marquee-in{display:inline-block;animation:mq 30s linear infinite}
.marquee-in span{margin:0 26px}
.marquee-in b{color:var(--champagne);font-weight:500}
@keyframes mq{to{transform:translateX(-50%)}}

/* ===== HEADER ===== */
header{position:sticky;top:0;z-index:80;background:rgba(252,252,250,.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--hairline)}
.nav{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;height:74px;gap:20px}
.nav-links{display:flex;gap:32px;font-size:11.5px;letter-spacing:.18em;text-transform:uppercase}
.nav-links a{padding:6px 0;position:relative}
.nav-links a::after{content:"";position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--noir);transition:width .3s var(--ease)}
.nav-links a:hover::after{width:100%}
.logo{justify-self:center}.logo img{height:32px}
.nav-utils{display:flex;gap:22px;justify-self:end}
.ic{width:19px;height:19px;stroke:var(--noir);fill:none;stroke-width:1.3}
.burger{display:none;flex-direction:column;gap:5px;justify-self:start}
.burger span{width:22px;height:1px;background:var(--noir)}
.crumb{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--smoke);padding:20px 0 0}
.crumb a:hover{color:var(--noir)}.crumb span{margin:0 9px;opacity:.4}

/* ===== HERO ===== */
.hero{display:grid;grid-template-columns:1.3fr 1fr;gap:clamp(30px,4vw,60px);padding:20px 0 64px;align-items:start}
.gal{position:sticky;top:96px;display:grid;grid-template-columns:68px 1fr;gap:14px}
.gal-rail{display:flex;flex-direction:column;gap:11px;max-height:660px;overflow-y:auto;scrollbar-width:none}
.gal-rail::-webkit-scrollbar{display:none}
.gth{flex:0 0 auto;aspect-ratio:1;overflow:hidden;background:var(--bone);opacity:.55;transition:opacity .25s;position:relative}
.gth.on{opacity:1}.gth.on::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--noir)}
.gth:hover{opacity:1}.gth img{width:100%;height:100%;object-fit:cover}
.gmain{position:relative;overflow:hidden;background:var(--bone);aspect-ratio:4/4.5;cursor:zoom-in}
.gmain img{width:100%;height:100%;object-fit:cover;transition:opacity .4s var(--ease),transform .5s var(--ease)}
.gmain.zoomed{cursor:zoom-out}.gmain.zoomed img{transform:scale(1.9)}
.gtag{position:absolute;top:14px;left:14px;font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:#fff;background:rgba(19,18,17,.6);padding:8px 14px}
.gmain-col{display:flex;flex-direction:column;gap:12px}
.gjump{display:grid;grid-template-columns:1.3fr 1fr;gap:12px}
.gjump-card{border:1px solid var(--hairline);background:#fff;padding:16px 20px;display:flex;flex-direction:column;gap:3px;transition:border-color .2s,background .2s}
.gjump-card:hover{border-color:var(--noir);background:var(--gallery)}
.gjump-card .stars{color:var(--champagne);letter-spacing:2px;font-size:14px}
.gjump-card .qic{width:22px;height:22px;border-radius:50%;border:1px solid var(--champagne);color:var(--champagne);display:grid;place-items:center;font-family:var(--display);font-size:14px;font-style:italic}
.gjump-card b{font-family:var(--display);font-size:18px;font-weight:400}
.gjump-card em{font-style:normal;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--smoke)}
/* mobile swipe gallery — hidden on desktop */
.mgal{display:none;position:relative}
.mgal-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.mgal-track::-webkit-scrollbar{display:none}
.mgal-slide{flex:0 0 100%;scroll-snap-align:center;aspect-ratio:1;background:var(--bone)}
.mgal-slide img{width:100%;height:100%;object-fit:cover}
.mgal-count{position:absolute;top:14px;right:14px;background:rgba(19,18,17,.62);color:#fff;font-size:11px;letter-spacing:.08em;padding:5px 11px;border-radius:100px}
.mgal-dots{display:flex;gap:6px;justify-content:center;margin-top:14px}
.mgal-dots button{width:6px;height:6px;border-radius:50%;background:var(--hairline-dk);padding:0;transition:all .25s}
.mgal-dots button.on{background:var(--noir);width:18px;border-radius:3px}

/* purchase card */
.pc{border:1px solid var(--hairline);background:#fff;padding:clamp(24px,2.4vw,36px)}
.pc-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:10px}
.pc-rating{font-size:12px;color:var(--smoke)}
.pc-rating .stars{color:var(--noir);letter-spacing:2px}
.pc-rating a{border-bottom:1px solid var(--hairline-dk)}
.pc-rating em{font-style:normal;color:var(--smoke);margin-left:8px;letter-spacing:.04em}
.pc-acts{display:flex;gap:13px}
.pc-acts button{opacity:.6;transition:opacity .2s}.pc-acts button:hover{opacity:1}
.pc h1{font-size:clamp(26px,2.4vw,34px);margin-bottom:14px}
.spec-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.spec-chips span{border:1px solid var(--hairline);padding:6px 12px;font-size:11px;letter-spacing:.05em;color:var(--smoke);background:var(--gallery)}
.spec-chips b{color:var(--noir);font-weight:500}
.viewed{font-size:11.5px;color:var(--smoke);margin-bottom:16px;display:flex;align-items:center;gap:7px}
.viewed i{width:6px;height:6px;border-radius:50%;background:var(--ok);animation:pl 2s infinite}
@keyframes pl{0%{box-shadow:0 0 0 0 rgba(61,122,92,.4)}70%{box-shadow:0 0 0 6px rgba(61,122,92,0)}100%{box-shadow:0 0 0 0 rgba(61,122,92,0)}}
.viewed b{color:var(--noir);font-weight:500}

.pc-price{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.pc-price .now{font-family:var(--display);font-size:32px}
.pc-price .was{font-size:14px;color:var(--smoke);text-decoration:line-through}
.pc-price .off{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ok);font-weight:500}
.offer-lines{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 6px}
.offer-lines span{background:var(--champagne-lt);color:#7a5f30;font-size:11px;letter-spacing:.04em;padding:5px 11px;font-weight:500}
.pc-ctx{font-size:11.5px;color:var(--smoke);margin-bottom:22px;padding-bottom:20px;border-bottom:1px solid var(--hairline)}
.pc-ctx b{color:var(--noir);font-weight:500}

.opt{margin-bottom:20px}
.opt-h{display:flex;justify-content:space-between;margin-bottom:10px;align-items:baseline;flex-wrap:wrap;gap:6px}
.opt-l{font-size:11px;letter-spacing:.2em;text-transform:uppercase;font-weight:500}
.opt-l span{color:var(--smoke);font-weight:400;letter-spacing:.02em;text-transform:none;font-size:12.5px;margin-left:7px}
.opt-a{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--smoke);border-bottom:1px solid var(--hairline-dk);padding-bottom:1px}
.opt-a:hover{color:var(--noir)}

/* 6 metal+karat swatches */
.metals{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;max-width:420px}
.mt{display:flex;flex-direction:column;align-items:center;gap:7px;font-size:10px;letter-spacing:.03em;color:var(--smoke);text-align:center;line-height:1.3}
.mt i{width:44px;height:44px;border-radius:50%;border:1px solid var(--hairline);display:grid;place-items:center;font-style:normal;font-size:10px;font-weight:600;letter-spacing:.02em;transition:box-shadow .2s}
.mt.sel i{box-shadow:0 0 0 2px #fff,0 0 0 3.5px var(--noir)}
.mt.sel{color:var(--noir);font-weight:500}
.m-y{background:linear-gradient(140deg,#F2DC9F,#C6A050);color:#5d4716}
.m-r{background:linear-gradient(140deg,#F0CDBD,#C5896F);color:#6d3f2b}
.m-w{background:linear-gradient(140deg,#F6F6F6,#C8CBD0);color:#4d5258}

/* size chips */
.sizes{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.sizes button{border:1px solid var(--hairline-dk);padding:10px 0;font-size:12.5px;background:#fff;transition:.15s}
.sizes button:hover{border-color:var(--noir)}
.sizes button.sel{background:var(--noir);color:#fff;border-color:var(--noir)}
.size-note{font-size:11.5px;color:var(--smoke);margin-top:9px;line-height:1.6}
.size-note a{color:var(--noir);border-bottom:1px solid var(--hairline-dk)}

/* engraving */
.engrave{border:1px dashed var(--hairline-dk);padding:15px 16px;margin-bottom:18px;background:var(--gallery)}
.engrave-h{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:500;margin-bottom:5px}
.engrave-h em{font-style:normal;color:var(--ok)}
.engrave p{font-size:11.5px;color:var(--smoke);margin-bottom:10px}
.engrave input{width:100%;border:1px solid var(--hairline-dk);padding:10px 12px;background:#fff}
.engrave input:focus{outline:none;border-color:var(--noir)}
.engrave-prev{font-family:var(--display);font-style:italic;font-size:17px;color:var(--champagne);text-align:center;min-height:22px;margin-top:8px}
.engrave-ct{font-size:10.5px;color:var(--smoke);text-align:right;margin-top:3px}

.deliv{display:flex;gap:10px;align-items:flex-start;font-size:12px;color:var(--smoke);background:var(--ok-bg);padding:12px 14px;margin-bottom:20px;line-height:1.55}
.deliv b{color:var(--noir);font-weight:500}
.deliv svg{width:16px;height:16px;stroke:var(--ok);fill:none;stroke-width:1.5;flex-shrink:0;margin-top:2px}

.cta1{width:100%;background:var(--noir);color:#fff;padding:17px;font-size:12px;letter-spacing:.24em;text-transform:uppercase;font-weight:500;transition:background .25s}
.cta1:hover{background:#2A2825}
.save-scheme{display:flex;justify-content:center;gap:8px;font-size:11.5px;color:var(--smoke);padding:10px 0 12px}
.save-scheme b{color:var(--ok);font-weight:600}
/* Lucira-style description with read-more */
.pc-desc{font-size:13.5px;color:var(--smoke);line-height:1.7;margin-bottom:8px}
.pc-desc .more{display:none}
.pc-desc.open .more{display:inline}
.pc-desc-toggle{background:none;border:none;color:var(--noir);font-weight:500;font-size:12.5px;text-decoration:underline;text-underline-offset:3px;padding:0;margin-bottom:12px}
.pc-note{font-size:11.5px;color:var(--smoke);font-style:italic;margin-bottom:6px;line-height:1.5}
.pc-fulldetails{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--smoke);border-bottom:1px solid var(--hairline-dk);padding-bottom:2px;display:inline-block;margin-bottom:24px}
.pc-fulldetails:hover{color:var(--noir)}
/* per-swatch stock label */
.mt .stk{font-size:8.5px;letter-spacing:.04em;line-height:1.2;text-transform:uppercase}
.mt .stk.in{color:var(--ok)}
.mt .stk.made{color:var(--smoke)}
.mt.sel .stk.made{color:var(--smoke)}
/* size stock dot */
.sizes button{position:relative}
.sizes button.instock::after{content:"";position:absolute;top:5px;right:5px;width:5px;height:5px;border-radius:50%;background:var(--ok)}
.sizes button.sel.instock::after{background:#fff}
/* availability status line */
.avail-status{display:flex;align-items:center;gap:8px;font-size:12.5px;margin:4px 0 18px;padding:11px 14px;border:1px solid var(--hairline);background:var(--gallery)}
.avail-status .sdot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.avail-status.in .sdot{background:var(--ok)}
.avail-status.made .sdot{background:var(--champagne)}
.avail-status b{font-weight:500}
.avail-status.in b{color:var(--ok)}
.avail-status.made b{color:var(--champagne-deep,#8a6a34)}
/* dual booking CTAs */
.book-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:8px}
.book-btn{border:1px solid var(--noir);padding:14px 8px;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:500;background:#fff;transition:all .25s;display:flex;flex-direction:column;align-items:center;gap:4px;line-height:1.3}
.book-btn:hover{background:var(--noir);color:#fff}
.book-btn small{font-size:9.5px;letter-spacing:.04em;text-transform:none;opacity:.7;font-weight:400}
.book-btn svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.4}
.cta2{width:100%;border:1px solid var(--noir);padding:15px;font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;font-weight:500;background:#fff;transition:all .25s}
.cta2:hover{background:var(--noir);color:#fff}
.cta2-sub{text-align:center;font-size:11px;color:var(--smoke);margin:8px 0 22px}

/* trust carousel */
.tcar{border-top:1px solid var(--hairline);padding-top:18px;overflow:hidden}
.tcar-track{display:flex;transition:transform .5s var(--ease)}
.tcar-slide{flex:0 0 100%;display:flex;gap:14px;align-items:center;font-size:12.5px;color:var(--smoke);line-height:1.5}
.tcar-slide b{color:var(--noir);font-weight:500;display:block;font-size:13.5px;font-family:var(--display);letter-spacing:.01em;margin-bottom:2px}
.tcar-slide svg{width:26px;height:26px;stroke:var(--champagne);fill:none;stroke-width:1.3;flex-shrink:0}
.tcar-dots{display:flex;gap:7px;justify-content:center;margin-top:16px}
.tcar-dots button{width:6px;height:6px;border-radius:50%;background:var(--hairline-dk);padding:0;transition:all .25s}
.tcar-dots button.on{background:var(--noir);width:20px;border-radius:3px}

/* more ways */
.mways{margin-top:22px}
.mways-h{font-size:11px;letter-spacing:.2em;text-transform:uppercase;font-weight:500;margin-bottom:12px}
.mways-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.mway{border:1px solid var(--hairline);padding:14px;font-size:11.5px;color:var(--smoke);line-height:1.5;display:flex;justify-content:space-between;gap:8px;transition:border-color .2s;background:var(--gallery)}
.mway:hover{border-color:var(--noir)}
.mway b{color:var(--noir);font-weight:500;display:block;font-size:12.5px}
.mway .arr{color:var(--champagne);font-size:15px}
.mscheme{border:1px solid var(--hairline);padding:14px;font-size:12px;color:var(--smoke);line-height:1.6;margin-bottom:10px;background:var(--gallery)}
.mscheme b{color:var(--noir);font-weight:500}
.mscheme a{color:var(--champagne);border-bottom:1px solid var(--champagne);font-size:11px;letter-spacing:.08em;text-transform:uppercase;margin-left:6px}

/* ===== PRICE & SAVINGS ===== */
.psd{background:var(--bone)}
.psd-card{max-width:860px;margin:0 auto;background:#fff;border:1px solid var(--hairline)}
.psd-tabs{display:flex;border-bottom:1px solid var(--hairline)}
.psd-tabs button{flex:1;padding:16px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;color:var(--smoke);border-bottom:2px solid transparent;margin-bottom:-1px}
.psd-tabs button.on{color:var(--noir);border-color:var(--noir)}
.psd-pane{display:none;padding:clamp(20px,3vw,34px)}
.psd-pane.on{display:block}
.brk{width:100%;border-collapse:collapse;font-size:13px}
.brk td{padding:13px 4px;border-bottom:1px solid var(--hairline);vertical-align:top}
.brk td:last-child{text-align:right;font-weight:500;white-space:nowrap}
.brk .k b{display:block;color:var(--noir);font-weight:500}
.brk .k{color:var(--smoke);font-size:12px;line-height:1.5}
.brk tr.sub td{font-weight:500}
.brk tr.total td{font-family:var(--display);font-size:19px;border-bottom:none;padding-top:16px}
.cmp2{width:100%;border-collapse:collapse;font-size:13px}
.cmp2 th,.cmp2 td{padding:13px 10px;border-bottom:1px solid var(--hairline);text-align:center}
.cmp2 th:first-child,.cmp2 td:first-child{text-align:left;color:var(--smoke);font-weight:400}
.cmp2 thead th{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:500}
.cmp2 thead th.td{background:var(--noir);color:var(--gallery)}
.cmp2 td.td{font-weight:500;background:rgba(165,133,78,.05)}
.cmp2 tr.tot td{font-weight:600;font-size:14px}
.cmp2 tr.tot td.td{color:var(--ok)}
.psd-note{font-size:11.5px;color:var(--smoke);margin-top:16px;line-height:1.65}
.psd-save{display:flex;justify-content:space-between;align-items:center;gap:16px;background:var(--noir);color:var(--gallery);padding:16px clamp(20px,3vw,34px);flex-wrap:wrap}
.psd-save b{font-family:var(--display);font-size:22px;font-weight:400;color:var(--champagne)}
.psd-save span{font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.certblock{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,3vw,48px);align-items:center;padding:clamp(24px,3vw,40px) clamp(20px,3vw,34px);border-top:1px solid var(--hairline);background:linear-gradient(120deg,var(--noir),#1f1a1c);color:var(--gallery)}
.certblock-l .eyebrow{color:var(--champagne);display:block;margin-bottom:12px}
.certblock-l p{font-size:13px;color:rgba(252,252,250,.6);line-height:1.7;margin-bottom:16px;max-width:360px}
.certblock-cta{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--champagne);border-bottom:1px solid var(--champagne);padding-bottom:3px;font-weight:500;display:inline-block}
.certlogos-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(252,252,250,.12);border:1px solid rgba(252,252,250,.12)}
.clogo{background:#fff;padding:20px 10px;text-align:center;display:flex;flex-direction:column;gap:5px;justify-content:center;min-height:96px}
.clogo b{font-family:var(--display);font-size:26px;font-weight:500;color:var(--noir);letter-spacing:.06em;line-height:1}
.clogo span{font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--smoke)}

/* policy accordions */
.pol{max-width:860px;margin:26px auto 0}
.pitem{border:1px solid var(--hairline);border-bottom:none;background:#fff}
.pitem:last-child{border-bottom:1px solid var(--hairline)}
.pq{width:100%;display:flex;justify-content:space-between;align-items:center;padding:17px 22px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:500;text-align:left}
.pq span{font-size:18px;color:var(--champagne);font-weight:300;transition:transform .3s var(--ease)}
.pitem.open .pq span{transform:rotate(45deg)}
.pa{max-height:0;overflow:hidden;transition:max-height .35s var(--ease)}
.pa div{padding:0 22px 20px;font-size:13px;color:var(--smoke);line-height:1.75}
.pa b{color:var(--noir);font-weight:500}
.pa ul{list-style:none;display:grid;gap:8px;margin-top:6px}
.pa li{padding-left:16px;position:relative}
.pa li::before{content:"✦";position:absolute;left:0;color:var(--champagne);font-size:9px;top:5px}

/* ===== SECTIONS ===== */
section.blk{padding:clamp(64px,8vw,116px) 0}
.shead{max-width:640px;margin:0 auto clamp(40px,5vw,64px);text-align:center}
.shead .eyebrow{display:block;margin-bottom:16px}
.shead h2{font-size:clamp(28px,3.8vw,46px);margin-bottom:14px}
.shead p{font-size:14.5px;color:var(--smoke);line-height:1.75}

/* about editorial */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,5vw,80px);align-items:center;margin-bottom:clamp(40px,5vw,64px)}
.about-grid img{aspect-ratio:4/5;object-fit:cover;width:100%}
.about-grid h2{font-size:clamp(28px,3.4vw,42px);margin:16px 0 20px}
.about-grid h2 em{font-style:italic;color:var(--champagne)}
.about-grid>div>p{font-size:15px;color:var(--smoke);line-height:1.85;max-width:460px}
.stories{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--hairline);border:1px solid var(--hairline)}
.stcell{background:var(--gallery);padding:28px 24px}
.stcell .k{font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--champagne);margin-bottom:10px;font-weight:500}
.stcell h4{font-family:var(--display);font-size:19px;margin-bottom:9px}
.stcell p{font-size:12.5px;color:var(--smoke);line-height:1.65}

/* bespoke */
.bespoke{background:var(--noir);color:var(--gallery);text-align:center;padding:clamp(56px,7vw,90px) 24px}
.bespoke .eyebrow{display:block;margin-bottom:16px}
.bespoke h2{color:var(--gallery);font-size:clamp(28px,3.6vw,44px);max-width:560px;margin:0 auto 16px}
.bespoke h2 em{font-style:italic;color:var(--champagne)}
.bespoke p{color:rgba(252,252,250,.6);max-width:480px;margin:0 auto 28px;font-size:14.5px;line-height:1.75}
.bespoke a{display:inline-block;border:1px solid var(--champagne);color:var(--champagne);padding:15px 40px;font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:500;transition:.25s}
.bespoke a:hover{background:var(--champagne);color:var(--noir)}

/* product details explorer */
.pdx-sku{text-align:center;font-size:11px;letter-spacing:.14em;color:var(--smoke);margin-bottom:22px;text-transform:uppercase}
.pdx-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--hairline);border:1px solid var(--hairline);max-width:920px;margin:0 auto 0}
.pdx-tabs button{background:var(--gallery);padding:18px 14px;text-align:left;transition:background .2s}
.pdx-tabs button .k{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--smoke);display:block;margin-bottom:4px}
.pdx-tabs button b{font-family:var(--display);font-size:16px;font-weight:400}
.pdx-tabs button.on{background:var(--noir)}
.pdx-tabs button.on .k{color:var(--champagne)}
.pdx-tabs button.on b{color:var(--gallery)}
.pdx-pane{display:none;max-width:920px;margin:0 auto;border:1px solid var(--hairline);border-top:none;background:#fff;padding:clamp(24px,3.5vw,44px)}
.pdx-pane.on{display:block}
.pdx-hero{display:grid;grid-template-columns:180px 1fr;gap:clamp(20px,3vw,36px);margin-bottom:26px;align-items:center}
.pdx-hero img{aspect-ratio:1;object-fit:cover;width:100%;background:var(--bone)}
.pdx-hero h3{font-size:clamp(22px,2.4vw,30px);margin-bottom:10px}
.pdx-hero p{font-size:13.5px;color:var(--smoke);line-height:1.7}
.pdx-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--hairline);border:1px solid var(--hairline);margin-bottom:26px}
.pdx-stats div{background:var(--gallery);padding:16px 12px;text-align:center}
.pdx-stats b{font-family:var(--display);font-size:20px;font-weight:400;display:block}
.pdx-stats span{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--smoke)}
.pdx-lists{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,3vw,40px)}
.pdx-list h5{font-size:11px;letter-spacing:.2em;text-transform:uppercase;font-weight:500;margin-bottom:12px;color:var(--champagne)}
.pdx-list dl{font-size:13px}
.pdx-list dl div{display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px solid var(--hairline)}
.pdx-list dt{color:var(--smoke)}
.pdx-list dd{font-weight:500;text-align:right}

/* shop by video */
.vids{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.vid{position:relative;cursor:pointer}
.vid .vimg{aspect-ratio:3/4;overflow:hidden;background:var(--bone);position:relative}
.vid img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease)}
.vid:hover img{transform:scale(1.04)}
.vid .play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:46px;height:46px;border-radius:50%;background:rgba(252,252,250,.9);display:grid;place-items:center;font-size:13px}
.vid .dur{position:absolute;bottom:10px;right:10px;background:rgba(19,18,17,.7);color:#fff;font-size:10px;padding:3px 8px;letter-spacing:.06em}
.vid h5{font-family:var(--display);font-size:16px;font-weight:400;margin:12px 0 2px}
.vid p{font-size:11.5px;color:var(--smoke)}
.vid-note{text-align:center;font-size:11px;color:var(--smoke);margin-top:22px;letter-spacing:.04em}

/* community UGC */
.ugc{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
.ugc>div{aspect-ratio:1;overflow:hidden;position:relative;background:var(--bone)}
.ugc img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease)}
.ugc>div:hover img{transform:scale(1.05)}
.ugc span{position:absolute;left:0;right:0;bottom:0;padding:10px 12px;font-size:10.5px;color:#fff;background:linear-gradient(transparent,rgba(19,18,17,.6));line-height:1.4}
.ugc b{display:block;font-weight:500;letter-spacing:.04em}
.ugc-cta{text-align:center;margin-top:24px}
.ugc-cta a{font-size:11px;letter-spacing:.18em;text-transform:uppercase;border-bottom:1px solid var(--noir);padding-bottom:3px;font-weight:500}

/* 7 steps */
.steps{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:var(--hairline);border:1px solid var(--hairline);counter-reset:s}
.step{background:var(--gallery);padding:26px 16px;counter-increment:s;transition:background .25s}
.step:hover{background:#fff}
.step::before{content:counter(s);font-family:var(--display);font-size:22px;color:var(--champagne);display:block;margin-bottom:12px}
.step h5{font-family:var(--display);font-size:16px;font-weight:400;margin-bottom:5px}
.step p{font-size:11px;color:var(--smoke);line-height:1.55}

/* certificate */
.cert{background:var(--bone)}
.cert-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(30px,4vw,64px);align-items:center;max-width:1020px;margin:0 auto}
.cert-mock{background:#fff;border:1px solid var(--hairline-dk);padding:34px 30px;text-align:center;position:relative;box-shadow:0 24px 50px -30px rgba(19,18,17,.25)}
.cert-mock::before{content:"";position:absolute;inset:8px;border:1px solid var(--hairline)}
.cert-mock .ci{font-size:22px;letter-spacing:.3em;font-weight:600;margin-bottom:6px}
.cert-mock .ct{font-family:var(--display);font-size:21px;margin-bottom:2px}
.cert-mock .cs{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--smoke);margin-bottom:20px}
.cert-mock .cst{font-size:26px;color:var(--champagne);margin-bottom:14px}
.cert-mock .cn{font-size:13px;letter-spacing:.22em;font-weight:500;margin-bottom:4px}
.cert-mock .cf{font-size:10px;color:var(--smoke);letter-spacing:.1em;text-transform:uppercase}
.cert-txt h3{font-size:clamp(24px,2.6vw,32px);margin-bottom:14px}
.cert-txt>p{font-size:14px;color:var(--smoke);line-height:1.75;margin-bottom:18px}
.cert-txt ul{list-style:none;display:grid;gap:10px;font-size:13px;color:var(--smoke)}
.cert-txt li{padding-left:18px;position:relative}
.cert-txt li::before{content:"✓";position:absolute;left:0;color:var(--ok);font-weight:600}

/* lab vs mined */
.lvm table{width:100%;max-width:820px;margin:0 auto;border-collapse:collapse;font-size:13.5px;background:#fff;border:1px solid var(--hairline)}
.lvm th,.lvm td{padding:15px 18px;border-bottom:1px solid var(--hairline);text-align:center}
.lvm th:first-child,.lvm td:first-child{text-align:left;color:var(--smoke);font-weight:400}
.lvm thead th{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;font-weight:500}
.lvm thead th.td{background:var(--noir);color:var(--gallery)}
.lvm td.td{background:rgba(165,133,78,.05)}
.lvm .y{color:var(--ok);font-weight:600}
.lvm .n{color:var(--smoke)}
.lvm tbody tr:last-child td{border-bottom:none}

/* promise */
.promise{background:var(--noir);color:var(--gallery)}
.promise .shead h2{color:var(--gallery)}
.promise .shead p{color:rgba(252,252,250,.55)}
.prom-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(252,252,250,.12);border:1px solid rgba(252,252,250,.12)}
.prom{background:var(--noir);padding:34px 28px}
.prom .n{font-family:var(--display);font-size:15px;color:var(--champagne);display:block;margin-bottom:14px}
.prom h4{font-family:var(--display);font-size:21px;font-weight:400;margin-bottom:9px;color:var(--gallery)}
.prom p{font-size:12.5px;color:rgba(252,252,250,.55);line-height:1.65}

/* reviews */
.rev-top{display:grid;grid-template-columns:280px 1fr;gap:clamp(28px,4vw,56px);margin-bottom:40px;align-items:start}
.rev-score{border:1px solid var(--hairline);padding:32px 28px;text-align:center;background:#fff}
.rev-score .big{font-family:var(--display);font-size:60px;line-height:1}
.rev-score .stars{letter-spacing:3px;margin:8px 0 4px;font-size:15px}
.rev-score>p{font-size:12px;color:var(--smoke);margin-bottom:6px}
.rev-score .rec{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ok);font-weight:500;margin-bottom:20px}
.rev-dist{display:grid;gap:8px;text-align:left}
.rd{display:flex;align-items:center;gap:10px;font-size:11px;color:var(--smoke)}
.rd .t{flex:1;height:3px;background:var(--bone)}
.rd .t i{display:block;height:100%;background:var(--noir)}
.rev-filters{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:22px}
.rev-filters button{border:1px solid var(--hairline-dk);padding:8px 16px;font-size:11.5px;background:#fff}
.rev-filters button.on{background:var(--noir);color:#fff;border-color:var(--noir)}
.rev-list{display:grid;gap:16px}
.rcard{border:1px solid var(--hairline);background:#fff;padding:24px 26px;display:grid;grid-template-columns:44px 1fr;gap:16px}
.rav{width:44px;height:44px;border-radius:50%;background:var(--champagne-lt);color:var(--champagne);display:grid;place-items:center;font-size:13px;font-weight:600}
.rcard .rh{display:flex;gap:12px;align-items:baseline;flex-wrap:wrap;margin-bottom:6px}
.rcard .rh b{font-weight:500}
.rcard .ver{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ok);font-weight:500}
.rcard .stars{font-size:12px;letter-spacing:2px}
.rcard .rq{font-size:13.5px;color:var(--smoke);line-height:1.75;margin:8px 0 10px}
.rcard .rm{font-size:11.5px;color:var(--smoke)}
.rev-all{text-align:center;margin-top:26px}
.rev-all a{font-size:11px;letter-spacing:.18em;text-transform:uppercase;border-bottom:1px solid var(--noir);padding-bottom:3px;font-weight:500}

/* faq */
.faq-wrap{max-width:780px;margin:0 auto}
.fitem{border-bottom:1px solid var(--hairline)}
.fq{width:100%;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:23px 0;text-align:left;font-family:var(--display);font-size:20px}
.fq span{font-size:20px;color:var(--champagne);font-weight:300;transition:transform .3s var(--ease);flex-shrink:0}
.fitem.open .fq span{transform:rotate(45deg)}
.fa{max-height:0;overflow:hidden;transition:max-height .35s var(--ease)}
.fa p{font-size:13.5px;color:var(--smoke);line-height:1.75;padding-bottom:22px}

/* product cards */
.prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.pcard{cursor:pointer;position:relative}
.pcard .badge{position:absolute;top:12px;left:12px;z-index:2;background:#fff;font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;padding:5px 10px;font-weight:500}
.pcard .pimg{aspect-ratio:1;overflow:hidden;background:var(--bone);margin-bottom:12px}
.pcard img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease)}
.pcard:hover img{transform:scale(1.04)}
.pcard h4{font-family:var(--display);font-size:17px;font-weight:400;margin-bottom:2px}
.pcard .pm{font-size:11.5px;color:var(--smoke)}
.pcard .pp{font-size:13.5px;font-weight:500;margin-top:5px}
.grid8{grid-template-columns:repeat(4,1fr)}
.range{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.range a{border:1px solid var(--hairline-dk);padding:11px 22px;font-size:12px;letter-spacing:.06em;transition:.2s;background:#fff}
.range a:hover{background:var(--noir);color:#fff;border-color:var(--noir)}

/* press */
.press{background:var(--bone)}
.press-grid{display:flex;justify-content:center;gap:clamp(20px,3.5vw,44px);flex-wrap:wrap}
.pr{text-align:center;width:120px}
.pr i{display:grid;place-items:center;width:84px;height:84px;border-radius:50%;border:1px solid var(--hairline-dk);font-family:var(--display);font-size:15px;margin:0 auto 10px;background:#fff;font-style:normal;line-height:1.15;text-align:center;padding:8px}
.pr b{font-size:12px;font-weight:500;display:block}
.pr span{font-size:10.5px;color:var(--smoke)}

/* stores */
.stores-filter{display:flex;gap:9px;justify-content:center;margin-bottom:28px;flex-wrap:wrap}
.stores-filter button{border:1px solid var(--hairline-dk);padding:9px 20px;font-size:11.5px;background:#fff}
.stores-filter button.on{background:var(--noir);color:#fff;border-color:var(--noir)}
.stores-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.store{border:1px solid var(--hairline);background:#fff;padding:24px}
.store .sc{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:8px}
.store h4{font-family:var(--display);font-size:19px;font-weight:400}
.store .stock{font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:500;padding:4px 9px;white-space:nowrap}
.store .stock.in{color:var(--ok);background:var(--ok-bg)}
.store .stock.ship{color:var(--champagne);background:var(--champagne-lt)}
.store .addr{font-size:12px;color:var(--smoke);line-height:1.6;margin-bottom:10px}
.store .meta{font-size:11.5px;color:var(--smoke);margin-bottom:16px}
.store .meta b{color:var(--noir);font-weight:500}
.store .acts{display:flex;gap:8px;flex-wrap:wrap}
.store .acts a{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;border:1px solid var(--hairline-dk);padding:8px 14px;font-weight:500;transition:.2s}
.store .acts a:first-child{background:var(--noir);color:#fff;border-color:var(--noir)}
.store .acts a:hover{border-color:var(--noir)}

/* newsletter + footer */
.newsletter{background:var(--bone);text-align:center;padding:clamp(44px,6vw,70px) 20px}
.newsletter h3{font-family:var(--display);font-size:clamp(24px,2.8vw,32px);font-weight:400;margin-bottom:8px}
.newsletter p{font-size:13px;color:var(--smoke);margin-bottom:22px}
.news-in{display:flex;max-width:430px;margin:0 auto;border:1px solid var(--hairline-dk);background:#fff}
.news-in input{flex:1;border:none;padding:14px 16px;background:transparent}
.news-in input:focus{outline:none}
.news-in button{background:var(--noir);color:#fff;padding:0 26px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:500}
footer{background:var(--noir);color:rgba(252,252,250,.75);padding:66px 0 26px}
.fgrid{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;gap:40px;padding-bottom:44px;border-bottom:1px solid rgba(252,252,250,.12)}
.fbrand img{height:32px;margin-bottom:18px;filter:brightness(0) invert(1)}
.fbrand p{font-size:12.5px;color:rgba(252,252,250,.5);line-height:1.8;max-width:280px;margin-bottom:14px}
.fbrand a{display:block;font-size:12.5px;color:rgba(252,252,250,.65);padding:3px 0}
.fcol h5{font-size:10px;letter-spacing:.26em;text-transform:uppercase;color:var(--champagne);margin-bottom:16px;font-weight:500}
.fcol a{display:block;font-size:13px;color:rgba(252,252,250,.65);padding:4.5px 0;transition:color .2s}
.fcol a:hover{color:var(--gallery)}
.fsearch{padding:26px 0;border-bottom:1px solid rgba(252,252,250,.12)}
.fsearch h6{font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--champagne);margin-bottom:12px;font-weight:500}
.fsearch p{font-size:11px;color:rgba(252,252,250,.4);line-height:2}
.fsearch a{color:rgba(252,252,250,.55)}
.fsearch a:hover{color:var(--gallery)}
.fbot{padding-top:24px;display:flex;justify-content:space-between;font-size:11.5px;color:rgba(252,252,250,.4);flex-wrap:wrap;gap:12px}

/* sticky bars */
.dsticky{position:fixed;left:0;right:0;bottom:0;z-index:75;background:rgba(252,252,250,.97);backdrop-filter:blur(14px);border-top:1px solid var(--hairline);transform:translateY(110%);transition:transform .4s var(--ease)}
.dsticky.on{transform:none}
.dsticky-in{max-width:var(--maxw);margin:0 auto;padding:12px clamp(20px,4vw,56px);display:flex;align-items:center;gap:20px}
.dsticky img{width:50px;height:50px;object-fit:cover;background:var(--bone)}
.dsticky .dn{flex:1}
.dsticky .dn b{font-family:var(--display);font-size:16px;font-weight:400;display:block}
.dsticky .dn span{font-size:11.5px;color:var(--smoke)}
.dsticky .dp{font-family:var(--display);font-size:20px}
.dsticky .b1{background:var(--noir);color:#fff;padding:13px 30px;font-size:11px;letter-spacing:.2em;text-transform:uppercase;font-weight:500}
.dsticky .b2{border:1px solid var(--noir);padding:12px 24px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:500}
.msticky{display:none;position:fixed;left:0;right:0;bottom:0;z-index:75;background:#fff;border-top:1px solid var(--hairline);box-shadow:0 -8px 26px rgba(19,18,17,.08)}
.msticky-in{display:grid;grid-template-columns:54px 54px 1fr;gap:8px;padding:10px 12px;align-items:stretch}
.msticky .mi{border:1px solid var(--hairline-dk);display:grid;place-items:center;padding:12px 0}
.msticky .mi svg{width:19px;height:19px;stroke:var(--noir);fill:none;stroke-width:1.5}
.msticky .mi.wa svg{fill:#128C7E;stroke:none}
.msticky .matc{background:var(--noir);color:#fff;font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:500;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px}
.msticky .matc small{font-size:9.5px;opacity:.7;letter-spacing:.06em;text-transform:none}
.toast{position:fixed;top:92px;right:26px;z-index:100;background:var(--noir);color:#fff;padding:15px 22px;font-size:12.5px;transform:translateX(140%);transition:transform .4s var(--ease);display:flex;gap:10px;align-items:center}
.toast.show{transform:none}
.toast svg{width:15px;height:15px;stroke:var(--champagne);fill:none;stroke-width:1.8}

@media(max-width:1080px){
  .nav-links{display:none}.burger{display:flex}
  .hero{grid-template-columns:1fr}
  .gal{position:static;grid-template-columns:1fr}
  .gal-rail{flex-direction:row;order:2;max-height:none;overflow-x:auto}
  .gth{width:62px}
  .about-grid,.cert-grid,.rev-top{grid-template-columns:1fr}
  .stories{grid-template-columns:1fr 1fr}
  .pdx-tabs{grid-template-columns:1fr 1fr}
  .pdx-hero{grid-template-columns:1fr}
  .pdx-hero img{max-width:220px}
  .pdx-lists{grid-template-columns:1fr}
  .vids,.prod-grid{grid-template-columns:repeat(2,1fr)}
  .ugc{grid-template-columns:repeat(3,1fr)}
  .steps{grid-template-columns:repeat(4,1fr)}
  .prom-grid,.stores-grid{grid-template-columns:1fr 1fr}
  .fgrid{grid-template-columns:1fr 1fr}
  .dsticky{display:none}
  .metals{grid-template-columns:repeat(3,1fr);max-width:260px;row-gap:16px}
}

/* ===== PHONE — Lucira-style ===== */
@media(max-width:768px){
  /* full-bleed swipe gallery, hide desktop stage + thumbs */
  .gal-rail,.gmain{display:none}
  .mgal{display:block;margin:0 calc(-1*clamp(20px,4vw,56px))}
  .hero{padding:8px 0 32px;gap:0}
