.engrave p{font-size:13.5px;line-height:1.7;margin-bottom:14px}
.engrave-trigger{width:100%;text-align:left;background:transparent;border:none;border-bottom:1px solid var(--hairline-dk);padding:12px 0;display:flex;align-items:center;justify-content:space-between;transition:border-color .25s}
