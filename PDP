/* ─── LUXURY POLISH (surgical) ─────────────────────────── */
/* headline drama: larger, tighter, with a champagne italic accent word */
.shead h2{font-size:clamp(32px,5vw,60px);line-height:1.02;letter-spacing:-.02em}
.shead h2 .gold,.shead h2 em{font-style:italic;color:var(--champagne);font-family:var(--display)}
.about-grid h2{font-size:clamp(30px,3.6vw,46px);letter-spacing:-.018em}
.about-grid h2 em{font-style:italic;color:var(--champagne)}
.bespoke h2 em,.newsletter h3 em{font-style:italic;color:var(--champagne)}

/* eyebrow hairline that draws in on reveal */
.eyebrow{display:inline-flex;align-items:center;gap:12px}
.eyebrow::before{content:"";width:0;height:1px;background:var(--champagne);opacity:.75;transition:width .9s var(--ease) .15s}
.rv.in .eyebrow::before,.shead .eyebrow::before{width:28px}

/* primary CTA — slow champagne sheen sweep on hover */
.cta1{position:relative;overflow:hidden}
.cta1::after{content:"";position:absolute;top:0;left:-125%;width:55%;height:100%;background:linear-gradient(100deg,transparent,rgba(239,231,214,.45),transparent);transform:skewX(-18deg);transition:left .75s var(--ease);pointer-events:none}
.cta1:hover::after{left:135%}

/* staggered reveals for grids — children arrive with rhythm */
:is(.stories,.prom-grid,.prod-grid,.press-grid,.steps,.vids,.ugc).rv{opacity:1;transform:none}
.dtiles-wrap.rv{opacity:1;transform:none}
:is(.stories,.prom-grid,.prod-grid,.press-grid,.steps,.vids,.ugc).rv>*,.dtiles-wrap.rv .dtile{opacity:0;transform:translateY(24px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
:is(.stories,.prom-grid,.prod-grid,.press-grid,.steps,.vids,.ugc).rv.in>*,.dtiles-wrap.rv.in .dtile{opacity:1;transform:none}
:is(.stories,.prom-grid,.prod-grid,.press-grid,.steps,.vids,.ugc).rv.in>*:nth-child(2),.dtiles-wrap.rv.in .dtile:nth-child(2){transition-delay:.08s}
:is(.stories,.prom-grid,.prod-grid,.press-grid,.steps,.vids,.ugc).rv.in>*:nth-child(3),.dtiles-wrap.rv.in .dtile:nth-child(3){transition-delay:.16s}
:is(.stories,.prom-grid,.prod-grid,.press-grid,.steps,.vids,.ugc).rv.in>*:nth-child(4),.dtiles-wrap.rv.in .dtile:nth-child(4){transition-delay:.24s}
:is(.stories,.prom-grid,.prod-grid,.press-grid,.steps,.vids,.ugc).rv.in>*:nth-child(5){transition-delay:.32s}
:is(.stories,.prom-grid,.prod-grid,.press-grid,.steps,.vids,.ugc).rv.in>*:nth-child(6){transition-delay:.40s}
:is(.steps,.ugc,.press-grid).rv.in>*:nth-child(7){transition-delay:.48s}
:is(.steps,.ugc,.press-grid).rv.in>*:nth-child(8){transition-delay:.56s}

/* about imagery — subtle scroll parallax hook */
.about-grid .rv{overflow:hidden}
.about-grid .rv img{will-change:transform}

/* ─── requested refinements ─────────────────────────────── */
.dtile-type{font-size:24px}
.dtile-grade{font-size:11.5px}
.dtile-price{font-size:17px}
.dtile-brk{font-size:11.5px}
.pcj-tx em{font-size:12px}
.size-note{font-size:12.5px}
.mt{font-size:11px}
.cta2-sub{font-size:12px}
