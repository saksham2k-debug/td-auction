/* ============================================================
   LUCIRA-STYLE REVAMP — light · minimal · soft-rounded · modern
   Full visual override layer (keeps all structure/JS intact)
   ============================================================ */
:root{
  --gallery:#FFFFFF;
  --bone:#F6F4F0;
  --noir:#1B1A18;
  --smoke:#767470;
  --champagne:#A9885F;
  --champagne-lt:#F0E9DE;
  --hairline:rgba(27,26,24,.09);
  --hairline-dk:rgba(27,26,24,.18);
  --ok:#2F7A57;--ok-bg:#EDF4EF;
  --display:'Fraunces',Georgia,serif;
  --ui:'Jost','Inter',-apple-system,sans-serif;
  --r:16px;--r-sm:11px;--pill:100px;
}
body{font-family:var(--ui);letter-spacing:.005em}
h1,h2,h3,h4{font-family:var(--display);font-weight:400;letter-spacing:0}
.eyebrow{color:var(--champagne);letter-spacing:.26em;font-weight:500}

/* soft neutral marquee instead of hard black */
.marquee{background:var(--bone);color:var(--noir);border-bottom:1px solid var(--hairline)}
.marquee-in b{color:var(--champagne)}

/* header — airy */
header{background:rgba(255,255,255,.9)}
.nav{height:70px}
.nav-links{font-weight:400;letter-spacing:.14em}

/* ---- rounded soft cards + pill buttons everywhere ---- */
.pc{border-radius:var(--r);border-color:var(--hairline);box-shadow:0 1px 0 var(--hairline)}
.cta1{border-radius:var(--pill);letter-spacing:.16em}
.cta2,.book-btn{border-radius:var(--pill)}
.chips button{border-radius:var(--pill)}
.sizes button{border-radius:var(--r-sm)}
.gjump-card{border-radius:var(--r-sm)}
.mgal-slide,.gmain{border-radius:var(--r)}
.engrave,.deliv,.avail-status,.mway,.mscheme,.pincode{border-radius:var(--r-sm)}
.engrave input,.pincode-in input,.news-in,.news-in input{border-radius:var(--r-sm)}
.offer-lines span,.pill,.stage-badge{border-radius:var(--pill)}
.psd-card,.pol .pitem:first-child{border-radius:var(--r) var(--r) 0 0;overflow:hidden}
.pol .pitem:last-child{border-radius:0 0 var(--r) var(--r)}
.accs{border-radius:var(--r);overflow:hidden}
.spec-card,.cmp,.cmp-table,.lvm table,.cmp2,.rev-score,.rcard,.rev-card,.store,.pdx-pane,.pdx-tabs{border-radius:var(--r);overflow:hidden}
.pcard .pimg,.rel-img,.vid .vimg,.about-grid img,.story-img,.specs-visual,.edit-img,.ugc>div,.mgal{border-radius:var(--r)}
.cert-mock{border-radius:var(--r)}
.range a{border-radius:var(--pill)}
.stores-filter button,.rev-filters button,.psd-tabs button{border-radius:var(--pill)}
.rev-filters button,.stores-filter button{border-radius:var(--pill)}

/* ---- LIGHTEN the dark editorial sections (Lucira is light throughout) ---- */
/* Bespoke */
.bespoke{background:var(--bone);color:var(--noir);border-radius:var(--r)}
.bespoke h2{color:var(--noir)}
.bespoke p{color:var(--smoke)}
.bespoke a{border-color:var(--champagne);color:var(--champagne)}
.bespoke a:hover{background:var(--champagne);color:#fff}

/* Promise */
.promise{background:var(--bone);color:var(--noir)}
.promise .shead h2{color:var(--noir)}
.promise .shead p{color:var(--smoke)}
.prom-grid{background:var(--hairline);border-color:var(--hairline)}
.prom{background:#fff}
.prom h4{color:var(--noir)}
.prom p{color:var(--smoke)}
.prom .n{color:var(--champagne)}

/* Certificate call-out block */
.certblock{background:var(--bone);color:var(--noir);border-color:var(--hairline)}
.certblock-l p{color:var(--smoke)}
.certlogos-grid{background:var(--hairline);border-color:var(--hairline)}

/* Footer — light, minimal */
footer{background:var(--bone);color:var(--smoke);border-top:1px solid var(--hairline)}
.fgrid{border-bottom-color:var(--hairline)}
.fbrand img{filter:none}
.fbrand p{color:var(--smoke)}
.fbrand a{color:var(--smoke)}
.fbrand a:hover{color:var(--noir)}
.fcol h5{color:var(--champagne)}
.fcol a{color:var(--smoke)}
.fcol a:hover{color:var(--noir)}
.fsearch{border-bottom-color:var(--hairline)}
.fsearch h6{color:var(--champagne)}
.fsearch p{color:var(--smoke)}
.fsearch a{color:var(--smoke)}
.fsearch a:hover{color:var(--noir)}
.fbot{color:var(--smoke)}

/* dark buttons stay dark but pill; product-detail active tab softens */
.pdx-tabs button.on{background:var(--noir)}
.dsticky .b1,.msticky .matc,.cta1{background:var(--noir)}
.news-in button{border-radius:0 var(--pill) var(--pill) 0}

/* newsletter block rounded */
.newsletter{border-radius:0}

/* trust carousel dot + swatch selection softer */
