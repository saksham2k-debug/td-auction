  const gold=20992, making=4508, accents=22050;
  const centre=net-gold-making-accents;
  return '<table class="brk">'+
    '<tr><td class="k"><b>Gold</b>14K · 2.25g net weight</td><td>'+fmt(gold)+'</td></tr>'+
    '<tr><td class="k"><b>Centre diamond</b>3.00 ct · Portuguese cut</td><td>'+fmt(centre)+'</td></tr>'+
    '<tr><td class="k"><b>Accents (6)</b>0.63 ct total · marquise</td><td>'+fmt(accents)+'</td></tr>'+
    '<tr><td class="k"><b>Making charges</b>Tulip prong · petal halo</td><td>'+fmt(making)+'</td></tr>'+
    '<tr><td class="k"><b>GST (3%)</b></td><td>'+fmt(gst)+'</td></tr>'+
    '<tr class="total"><td>Total</td><td>'+fmt(p)+'</td></tr></table>';
}

/* stacked diamond tiles */
function selectTile(t){
  document.querySelectorAll('.dtile').forEach(x=>x.classList.remove('sel'));
  t.classList.add('sel');
  dtype=t.dataset.type;dgrade=t.dataset.grade;
  var _dl=document.getElementById('dLab');if(_dl)_dl.textContent=(dtype==='lab'?'Lab Grown':'Natural')+' · '+dgrade;
  setPrice(+t.dataset.price);
}
document.querySelectorAll('.dtile').forEach(t=>{
  const brkBtn=t.querySelector('.dtile-brk'),brkBox=t.querySelector('.dtile-breakup');
  t.addEventListener('click',e=>{if(!e.target.closest('.dtile-brk'))selectTile(t);});
  brkBtn.addEventListener('click',e=>{
    e.stopPropagation();
    if(!brkBox.dataset.filled){brkBox.innerHTML=breakupHTML(+t.dataset.price);brkBox.dataset.filled='1';}
    const open=t.classList.toggle('brk-open');
    brkBox.style.maxHeight=open?brkBox.scrollHeight+'px':null;
    brkBtn.querySelector('.chev').style.transform=open?'rotate(180deg)':'';
  });
});

function updateAvail(){
  const el=document.getElementById('availStatus');
  if(!el)return;
  const inStock=(dtype==='lab'&&metalStock==='in'&&sizeStock==='in');
  el.classList.toggle('in',inStock);el.classList.toggle('made',!inStock);
  document.getElementById('availLabel').textContent=inStock?'In Stock':'Made to Order';
  document.getElementById('availSub').textContent=inStock?'· ready to ship insured':'· handcrafted & shipped in 7–10 days';
}
function ctx(){
  document.getElementById('ctxVar').textContent=metal+', size '+size;
  document.getElementById('dsVar').textContent=metal+' · Size '+size;
  document.getElementById('msVar').textContent=fmt(price)+' · '+metal.replace(' Gold','')+' · Size '+size;
  /* mobile summary card */
  const csM=document.getElementById('csMetal');if(csM)csM.textContent=metal;
  const csS=document.getElementById('csSize');if(csS)csS.textContent=size+' IND';
  const csD=document.getElementById('csDot');if(csD)csD.className='dot '+(metal.includes('Rose')?'m-r':metal.includes('White')?'m-w':'m-y');
  updateAvail();
}
document.querySelectorAll('#metals .mt').forEach(m=>m.addEventListener('click',()=>{
  document.querySelectorAll('#metals .mt').forEach(x=>x.classList.remove('sel'));
  m.classList.add('sel');metal=m.dataset.n;metalStock=m.dataset.stock;
  document.getElementById('mLab').textContent=metal;ctx();
}));

/* sizes 5–18 — size 12 in stock, rest made-to-order */
const sz=document.getElementById('sizes');
const inStockSizes=[12];
for(let s=5;s<=18;s++){
  const b=document.createElement('button');b.textContent=s;
  if(inStockSizes.includes(s))b.classList.add('instock');
  if(s===12)b.classList.add('sel');
  b.title=inStockSizes.includes(s)?'In stock':'Made to order';
  b.addEventListener('click',()=>{
    sz.querySelectorAll('button').forEach(x=>x.classList.remove('sel'));
    b.classList.add('sel');size=s;sizeStock=inStockSizes.includes(s)?'in':'made';
    document.getElementById('szLab').textContent=s+' IND';ctx();
  });
  sz.appendChild(b);
}

/* mobile customize drawer */
(()=>{
  const area=document.getElementById('customizeArea'),bd=document.getElementById('custBackdrop');
  const open=()=>{area.classList.add('open');bd.classList.add('on');document.body.style.overflow='hidden';};
  const close=()=>{area.classList.remove('open');bd.classList.remove('on');document.body.style.overflow='';};
  const ob=document.getElementById('custOpen');if(ob)ob.addEventListener('click',open);
  const cb=document.getElementById('custClose');if(cb)cb.addEventListener('click',close);
  const db=document.getElementById('custDone');if(db)db.addEventListener('click',close);
  bd.addEventListener('click',close);
})();

/* engraving modal */
(()=>{
  const modal=document.getElementById('engModal');if(!modal)return;
  const trigger=document.getElementById('engTrigger'),disp=document.getElementById('engDisplay');
  const back=document.getElementById('engBack'),close=document.getElementById('engClose');
  const inp=document.getElementById('engModalIn'),count=document.getElementById('engCount'),save=document.getElementById('engSave');
  let font='Lobster';
  const open=()=>{modal.classList.add('open');document.body.style.overflow='hidden';setTimeout(()=>inp.focus(),120);};
  const shut=()=>{modal.classList.remove('open');document.body.style.overflow='';};
  trigger.addEventListener('click',open);
  back.addEventListener('click',shut);close.addEventListener('click',shut);
  document.getElementById('engFonts').addEventListener('click',e=>{
    const b=e.target.closest('.eng-font');if(!b)return;
    document.querySelectorAll('.eng-font').forEach(x=>x.classList.remove('sel'));
    b.classList.add('sel');font=b.dataset.font;
  });
  const clean=v=>v.replace(/[^A-Za-z0-9♥∞ ]/g,'').slice(0,8);
  inp.addEventListener('input',()=>{inp.value=clean(inp.value);count.textContent=inp.value.length;});
  document.querySelectorAll('.eng-sym').forEach(s=>s.addEventListener('click',()=>{
    if(inp.value.length<8){inp.value+=s.dataset.sym;count.textContent=inp.value.length;inp.focus();}
  }));
  save.addEventListener('click',()=>{
    const v=inp.value.trim();
    if(v){disp.textContent=v;disp.style.fontFamily="'"+font+"'";disp.classList.add('set');trigger.classList.add('has');}
    else{disp.textContent='Engrave';disp.style.fontFamily='';disp.classList.remove('set');trigger.classList.remove('has');}
    shut();
  });
})();

/* price tabs */
document.querySelectorAll('.psd-tabs button').forEach(t=>t.addEventListener('click',()=>{
  document.querySelectorAll('.psd-tabs button').forEach(x=>x.classList.remove('on'));
  document.querySelectorAll('.psd-pane').forEach(x=>x.classList.remove('on'));
  t.classList.add('on');document.getElementById(t.dataset.pane).classList.add('on');
}));

/* pdx tabs */
document.querySelectorAll('.pdx-tabs button').forEach(t=>t.addEventListener('click',()=>{
  document.querySelectorAll('.pdx-tabs button').forEach(x=>x.classList.remove('on'));
  document.querySelectorAll('.pdx-pane').forEach(x=>x.classList.remove('on'));
  t.classList.add('on');document.getElementById(t.dataset.pane).classList.add('on');
}));

/* accordions (policy + faq) */
function acc(sel,q,a){
  document.querySelectorAll(sel).forEach(it=>{
    const head=it.querySelector(q),body=it.querySelector(a);
    head.addEventListener('click',()=>{
      const open=it.classList.toggle('open');
      body.style.maxHeight=open?body.scrollHeight+'px':null;
    });
  });
}
acc('.pitem','.pq','.pa');acc('.fitem','.fq','.fa');

/* review filters */
document.querySelectorAll('.rev-filters button').forEach(f=>f.addEventListener('click',()=>{
  document.querySelectorAll('.rev-filters button').forEach(x=>x.classList.remove('on'));
  f.classList.add('on');
  const k=f.dataset.f;
  document.querySelectorAll('#revList .rcard').forEach(c=>{
    c.style.display=(k==='all'||(c.dataset.tags||'').includes(k))?'':'none';
  });
}));

/* store filter */
document.querySelectorAll('.stores-filter button').forEach(f=>f.addEventListener('click',()=>{
  document.querySelectorAll('.stores-filter button').forEach(x=>x.classList.remove('on'));
  f.classList.add('on');
  const c=f.dataset.c;
  document.querySelectorAll('#storesGrid .store').forEach(s=>{
    s.style.display=(c==='all'||s.dataset.c===c)?'':'none';
  });
}));

/* desktop sticky */
const ds=document.getElementById('dsticky'),pcard=document.getElementById('pcard');
new IntersectionObserver(es=>{
  ds.classList.toggle('on',!es[0].isIntersecting&&es[0].boundingClientRect.top<0);
},{threshold:0}).observe(pcard);

/* actions */
const toast=document.getElementById('toast');
function showToast(m){document.getElementById('toastMsg').textContent=m;toast.classList.add('show');clearTimeout(window._t);window._t=setTimeout(()=>toast.classList.remove('show'),2600);}
document.getElementById('atc').addEventListener('click',()=>showToast('Added to cart · ₹ 2,49,826 · '+metal+' · Size '+size));
document.getElementById('homeVisit').addEventListener('click',()=>showToast('Home trial requested — our team will WhatsApp you to schedule'));
document.getElementById('storeVisit').addEventListener('click',()=>showToast('Store visit noted — we\'ll send store details & directions'));
/* pincode delivery check */
(()=>{
  const btn=document.getElementById('pinLocate'),inp=document.getElementById('pinIn');
  if(!btn||!inp)return;
  inp.addEventListener('input',()=>inp.value=inp.value.replace(/\D/g,'').slice(0,6));
  btn.addEventListener('click',()=>{
    if(inp.value.length===6){showToast('Delivery available to '+inp.value+' · dispatch by Aug 4, 2026');}
    else{showToast('Enter a valid 6-digit pincode');inp.focus();}
  });
})();
/* read more (removed in declutter — guard) */
(()=>{const t=document.getElementById('descToggle');if(!t)return;
t.addEventListener('click',function(){
  const d=document.getElementById('pcDesc');const open=d.classList.toggle('open');
  this.textContent=open?'Read less':'Read more';
});})();
document.getElementById('wishBtn').addEventListener('click',function(){this.querySelector('svg').style.fill='var(--noir)';showToast('Saved to wishlist');});
document.getElementById('shareBtn').addEventListener('click',()=>{
  if(navigator.share)navigator.share({title:'Mystical Petal — True Diamond',url:location.href}).catch(()=>{});
  else{navigator.clipboard&&navigator.clipboard.writeText(location.href);showToast('Link copied');}
});
document.getElementById('newsBtn').addEventListener('click',()=>{
  const v=document.getElementById('newsIn').value;
  showToast(v.includes('@')?'Subscribed — welcome to the community':'Enter a valid email');
});
</script>
