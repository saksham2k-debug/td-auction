/* black reviews / faqs cards — clean, no symbols */
.pc-cards{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0 0 30px}
.pc-card{background:var(--noir);color:#fff;padding:17px 14px;text-align:center;transition:background .25s var(--ease),transform .25s var(--ease)}
